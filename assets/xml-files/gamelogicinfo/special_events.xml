<Events version_major = "1" version_minor = "0">

	
	<Event Name = "test_event" DisplayName = "test_event" Description = "The Frost Fest is upon us! A time to celebrate the longest night and hoard your gifts! Be wary though, the Feastlord and his Brownies are about, and they like to regulate the stealing of people's presents!">
	
		<Info>
			<Enabled     Value = "false"/>
			<ID          Value = "0"/>
			<IconName    Value = "ei_frost_fest.png"/>			
			<Persistent  Value = "true"/>
		</Info>
		
		<Conditions>
			<Start   Value = "SERVER_UP"/>
			<Restart Value = "IMMEDIATELY"/>
			<Repeat  Value = "INFINITE"/>
		</Conditions>
		<!-- Type = "SERVER_UP/GM_COMMAND/TIME_IN_DAY/RANDOM/DATE" -->
		
		
		<Step Type = "Monster" Index = "0" StepDescription = "Naughty Frost Fest Monsters are stealing Frost Fest gifts! Kill enough to unmask the mastermind!">
			<Monsters>
				<Monster Value = "r_Xmas Brownies"/>					
				<Monster Value = "r_feielrin event2"/>
				<Monster Value = "r_heielhim event"/>
				<Monster Value = "r_Spider Giant Event"/>
				<Monster Value = "r_Bear Arctic Event"/>
				<Monster Value = "r_Air Elemental Lesser Event"/>
				<Monster Value = "r_Earth Elemental Lesser Event"/>
				<Monster Value = "r_Fire Elemental Lesser Event"/>
				<Monster Value = "r_Ice Elemental Lesser Event"/>
				<Monster Value = "r_Salamander Event"/>
				<Monster Value = "r_Serpentine Event"/>
				<Monster Value = "r_Spirit Event"/>
				<Monster Value = "r_Khamset Slave Event"/>				
				<!--<Monster Value = "r_spider giant"/>					
				<Monster Value = "r_salamander"/>					
				<Monster Value = "r_brownie_01"/>					
				<Monster Value = "r_brownie_02"/>					
				<Monster Value = "r_sarnakh"/>		-->			
			</Monsters>				
			<!--<Limit debug_value = "5" live_value = "5"/>-->
			<Limit debug_value = "5" live_value = "6000"/>
		</Step>
		
		
		<Step Type = "BossKill" Index = "1" StepDescription = "The Feastlord has awoken and is ready to rumble! Who has dared touch his Brownies can come face his wrath!">
			<BossPreset Value = "event_oak_lord"/>
			<Spawnpoints>
				<Spawnpoint Value = "i20_spawns_04"/>
				<Spawnpoint Value = "i22_spawns_03"/>
				<Spawnpoint Value = "m11_spawns_01"/>
				<Spawnpoint Value = "m18_spawns_02"/>
				<Spawnpoint Value = "m20_spawns_01"/>
				<Spawnpoint Value = "p12_spawns_04"/>
				<Spawnpoint Value = "r12_spawns_01"/>
				<Spawnpoint Value = "w18_spawns_01"/>				
			</Spawnpoints>					
			<Limit debug_value = "1" live_value = "1"/>
			<Rewards Type = "AREA_OF_EVENT">
				<Reward Type = "SPAWNABLE" Value = "r_Frozen Presents"  Keys = "1" debug_value = "60" live_value = "60"/>
			</Rewards>
		</Step>
		
	</Event>
	
	<Event Name = "easy_skeletons" DisplayName = "easy_skeletons" Description = "Kill skeletons to spawn the boss. Kill the Boss">
		
		<Info>
			<Enabled     Value = "false"/>
			<ID          Value = "0"/>
			<IconName    Value = "ei_frost_fest.png"/>			
			<Persistent  Value = "true"/>
		</Info>
		
		<Conditions>
			<Start   Value = "SERVER_UP"/>
			<Restart Value = "IMMEDIATELY"/>
			<Repeat  Value = "INFINITE"/>
		</Conditions>
		<!-- Type = "SERVER_UP/GM_COMMAND/TIME_IN_DAY/RANDOM/DATE" -->
		
		
		<Step Type = "Monster" Index = "0" StepDescription = "Kill enough skeletons">
			<Monsters>
				<Monster Value = "r_skeleton brittle"/>					
				<Monster Value = "r_skeleton archer"/>
				<Monster Value = "r_skeleton warrior"/>						
			</Monsters>				
			<!--<Limit debug_value = "5" live_value = "5"/>-->
			<Limit debug_value = "5" live_value = "2000"/>
		</Step>
		
		
		<Step Type = "BossKill" Index = "1" StepDescription = "Kill the Skeleton Boss">
			<BossPreset Value = "event_easy_skeletons"/>
			<Spawnpoints>
				<Spawnpoint Value = "j09_spawns_03"/>
				<Spawnpoint Value = "n16_spawns_02"/>
				<Spawnpoint Value = "o24_spawns_02"/>
				<Spawnpoint Value = "p08_spawns_03"/>
				<Spawnpoint Value = "q20_spawns_04"/>
				<Spawnpoint Value = "q20_spawns_05"/>
				<Spawnpoint Value = "s10_spawns_02"/>								
			</Spawnpoints>					
			<Limit debug_value = "1" live_value = "1"/>
			<Rewards Type = "AREA_OF_EVENT">
				<Reward Type = "SPAWNABLE" Value = "r_Frozen Presents"  Keys = "0" debug_value = "5" live_value = "10"/>
			</Rewards>
		</Step>
		
	</Event>
	
	
</Events>