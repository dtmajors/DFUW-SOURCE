	<!--  CRAFTING SKILLS CAN NOT BE EXECUTED WHILE THERE IS A SHIELD ATTACHED -->
	<Mapping SkillName="s_Crafting Skills">
		<SFConstraint>
			<SFConstraintName>
				<SFString Value="Object_State_Value_Constraint" />
			</SFConstraintName>
			<SFCheckName>
				<SFString Value="Check_Initial_And_Performing" />
			</SFCheckName>
			<SFInvertCheck>
				<SFBool Value="TRUE" />
			</SFInvertCheck>
			<SFModeName>
				<SFString Value="ModeType PostureMode" />
			</SFModeName>
			<SFModeValueName>
				<SFString Value="PostureMode Crouching" />
			</SFModeValueName>
		</SFConstraint>
	    <SFConstraint>
	        <SFConstraintName>
	            <SFString Value="Inventory_Item_In_Layer_Constraint" />
	        </SFConstraintName>
	        <SFLayerName>
	            <SFString Value="Layer_Shield" />
	        </SFLayerName>
	        <SFInvertCheck>
	            <SFBool Value="FALSE" />
	        </SFInvertCheck>
	        <SFCheckName>
	            <SFString Value="Check_Initial_And_Performing" />
	        </SFCheckName>
	    </SFConstraint>
	</Mapping>
	
