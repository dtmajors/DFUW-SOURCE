#####                         Rules for WeaponMode                        #####
###############################################################################
-->
<!-- Rules for changing weaponmode to 'WeaponMode Unarmed' -->
<!-- #1 Changing from 'WeaponMode Combat' -->
    <SFStateChangeRule EventName="Event_Weapon_Sheathed">
        <SFRequirement CheckInverse="FALSE" ModeName="ModeType WeaponMode" ModeValueName="WeaponMode Combat" Name="ObjectStateRequirement" />
        <SFStateChange ModeName="ModeType WeaponMode" ModeValueName="WeaponMode Unarmed" />
    </SFStateChangeRule>
<!-- #2 Changing from 'WeaponMode Spell' -->
    <SFStateChangeRule EventName="Event_Magic_Staff_Sheathed">
        <SFRequirement CheckInverse="FALSE" ModeName="ModeType WeaponMode" ModeValueName="WeaponMode Spell" Name="ObjectStateRequirement" />
        <SFStateChange ModeName="ModeType WeaponMode" ModeValueName="WeaponMode Unarmed" />
    </SFStateChangeRule>
<!-- #3 Changing from 'WeaponMode Tool' -->
    <SFStateChangeRule EventName="Event_Tool_Detached">
        <SFRequirement CheckInverse="FALSE" ModeName="ModeType WeaponMode" ModeValueName="WeaponMode Tool" Name="ObjectStateRequirement" />
        <SFStateChange ModeName="ModeType WeaponMode" ModeValueName="WeaponMode Unarmed" />
    </SFStateChangeRule>
<!-- Rule for changing WeaponMode to 'WeaponMode Combat' -->
    <SFStateChangeRule EventName="Event_Weapon_Unsheathed">
        <SFRequirement CheckInverse="FALSE" ModeName="ModeType LifeMode" ModeValueName="LifeMode Alive" Name="ObjectStateRequirement" />
        <SFRequirement CheckInverse="TRUE" ModeName="ModeType WeaponMode" ModeValueName="WeaponMode Combat" Name="ObjectStateRequirement" />
        <SFStateChange ModeName="ModeType WeaponMode" ModeValueName="WeaponMode Combat" />
    </SFStateChangeRule>
<!-- Rule for changing WeaponMode to 'WeaponMode Spell' -->
    <SFStateChangeRule EventName="Event_Magic_Staff_Unsheathed">
        <SFRequirement CheckInverse="FALSE" ModeName="ModeType LifeMode" ModeValueName="LifeMode Alive" Name="ObjectStateRequirement" />
        <SFRequirement CheckInverse="TRUE" ModeName="ModeType WeaponMode" ModeValueName="WeaponMode Spell" Name="ObjectStateRequirement" />
        <SFStateChange ModeName="ModeType WeaponMode" ModeValueName="WeaponMode Spell" />
    </SFStateChangeRule>
<!-- Rule for changing WeaponMode to 'WeaponMode Tool' -->
    <SFStateChangeRule EventName="Event_Tool_Attached">
        <SFRequirement CheckInverse="FALSE" ModeName="ModeType LifeMode" ModeValueName="LifeMode Alive" Name="ObjectStateRequirement" />
        <SFRequirement CheckInverse="TRUE" ModeName="ModeType WeaponMode" ModeValueName="WeaponMode Tool" Name="ObjectStateRequirement" />
        <SFStateChange ModeName="ModeType WeaponMode" ModeValueName="WeaponMode Tool" />
    </SFStateChangeRule>
