<quest quest_id="4301" category="training_quest" tag="Foundry Template" published="False" valid="True">
	<title>Crafting Catapults</title>
	<description>What you will need to know, have and do so you can craft a $[Resource.S.r_siegeengine_catapult_NameSingular] at a $[Resource.C.r_clan_foundry_NameSingular].</description>
