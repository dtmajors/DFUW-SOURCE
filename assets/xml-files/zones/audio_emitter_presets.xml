<SFEmitterPresets>
	<!--
		-Id must be integer
		-Id  3 is the default preset ( any audio xml without the preset attribute set will default to 3 ) 
		-Id -1 is reserved ( means parameters will come from the game system i.e. -the sfx settings) 
		-Rolloff  0 = logarithmic 1 = linear 
		-in logarithmic max distance does not affect the sound but is instead the radius of the 3d emitter in the scenegraph. i.e. when the player
		listener touches the sphere of radius MaxDistance the audio gets activated(a rule of thumb is MaxDistance = 8 * MinDistance which means that at worse cases the volume will go from 0 to 1/8 of max volume of the sound when the sound is first activated)
		-we can have as many presets as we like but 
		-ids should be sequential i.e. dont leave large gaps ( e.g. id 100  ) 
		- in the sounds xmls specify the preset by adding attribute Preset in the node "SoundInformation" e.g. :
		<SoundInformation ObjectType="3DAUDIO" FileName="/damage/df_damage_unholy_1.wav" Preset = "11">
		</SoundInformation>
		- preset system is completely ignored for environmental 3d sounds ( 3d randomizers and placeable sound emitters )  
		
		Pitch Randomization: ( in cents  picks a random number  in  random[- PitchRandomization , PitchRandomization ] + PitchRandomizationOffset  )  
		VolumeRandomization: ( Picks a random number in  1.f - random[0 , VolumeRandomization]  and multiplies the volume by it. so if VolumeRandomization is 0.1f then it will adjust by 90% - 100% of the current volume 
	--> 
	<SFEmitterPreset Id = "1" RollOff = "1" MinDistance = "3" MaxDistance = "16" PitchRandomization = "0" PitchRandomizationOffset="0" VolumeRandomization="0" />
