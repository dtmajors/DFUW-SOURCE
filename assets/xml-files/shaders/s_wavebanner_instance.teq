//Banner wave shader

#include "stdstate.frag"
#include "windswing.frag"

#include "texture.frag"

#include "instancing.frag"
#include "shadowmap.frag"

bool InstancingShader : REInfoInstanceShader = true;
int InstanceVersion : REInfoInstanceType  = INSTANCE_WORLDMAT_AMBIENT_DIFFUSE;



struct VS_INPUT
{
    float4 Pos	: POSITION;
    float3 Norm : Normal;
    float2 Tex	: TEXCOORD0;
	//Instancing data
	float4 WMat1 : TEXCOORD5;
	float4 WMat2 : TEXCOORD6;
	float4 WMat3 : TEXCOORD7;
	float4 WMat4 : TEXCOORD8;
};


static const float RetractStart = 0.85f;


VS_SHADOWMAP_OUTPUT WaveBannerVS_1_1(VS_INPUT Input)
{
    VS_SHADOWMAP_OUTPUT Out = (VS_SHADOWMAP_OUTPUT)0;

	SFMatrix WMat;
	WMat[0] = Input.WMat1;
	WMat[1] = Input.WMat2;
	WMat[2] = Input.WMat3;
	WMat[3] = Input.WMat4;

    float3 ObjectSize = getBBScale();
    
    float3 MinValues;
	
    float3 NewPos = Input.Pos;
	
    //First retract in X if necessary
    float RetractVal = saturate(RetractStart + WIND_SPEED);
    

    float RetractVal2 = saturate(1.0f - (WIND_SPEED+RetractStart)) * ObjectSize.y*0.01f;
    
    MinValues.x = getXMin(NewPos.x);
    MinValues.y = getXMin(NewPos.y);

    float WindStr = saturate(WIND_SPEED + 0.3f);
    float WindSpd = saturate(0.5f*WIND_SPEED + 0.1f);


    float ScaleVal = 0.19f + WIND_SPEED*0.15f;
    float ScaleValY = 0.13f + WIND_SPEED*0.11f;
	
	float3 WorldTranslation = SFMatrixDecomposeTranslation(WMat);
	float3 RandSeed = SFMatrixNonTranslationSummary(WMat);
	
	float RandVal = frac(RandSeed.x + RandSeed.y + RandSeed.z);
	

    float WaveVal1 = SFGetPeriodicSinTimeValue( 0.0f , MinValues.x * WindStr * (ObjectSize.x*ScaleVal),   -WindSpd * 8.0f , RandVal + MinValues.x);
    float WaveVal2 = SFGetPeriodicSinTimeValue( 0.0f , MinValues.x * WindStr * (ObjectSize.y*ScaleVal),   -WindSpd * 13.0f , RandVal + MinValues.y);
    float WaveVal3 = SFGetPeriodicSinTimeValue( 0.0f , MinValues.x * WindStr * (ObjectSize.y*ScaleValY),   -WindSpd * 7.0f, RandVal + MinValues.x);
    

    float ScaledWav1 = WaveVal1/(MinValues.x * WindStr * (ObjectSize.x*ScaleVal));
    
	float3 PrevNewPos = NewPos;
	
    NewPos.z += WaveVal1 + WaveVal2;
    NewPos.y += WaveVal3;
	
	
    NewPos = SFVectorRotateY(NewPos,WIND_ROTATION.y);

	NewPos += WorldTranslation;
   
    Out.Pos  = mul(float4(NewPos,1.0f), SHADOW_VIEW_PROJECTION_MATRIX);             // position (projected)

	//PLANET_LIGHTCOLOR_COMMON
	Out.ScreenPos = Out.Pos;

    Out.Tex  = Input.Tex;

    return Out;
}


technique T0
{
    pass P0
    {
		STD_STATE;
   
    
		ColorWriteEnable = ALPHA|RED|BLUE|GREEN;

        AlphaBlendEnable = false;
        AlphaTestEnable = false;
        
        ZEnable = TRUE;
		ZWriteEnable = TRUE;
	
		Lighting = FALSE;
		FogEnable = TRUE;
        CullMode = CW;
	
        VertexShader = compile vs_3_0 WaveBannerVS_1_1();
        PixelShader  = compile ps_3_0 ShadowMapPS();
    }
}
