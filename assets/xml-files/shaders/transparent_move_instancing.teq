// Note: Update light model
#include "stdstate.frag"
#include "matrix.frag"
#include "windswing.frag"
#include "texture.frag"
#include "instancing.frag"
#include "ssao.frag"
#include "lighting.frag"
#include "std_vertex.frag"
#include "combine_illumination.frag"
#include "offscreenfx.frag"


#ifdef SHADER_DYNAMIC_LIGHTS_ENABLE
#include "dynamic_lights.frag"
#endif

//Tell that this one is an instancing shader
bool InstancingShader : REInfoInstanceShader = true;
int InstanceVersion : REInfoInstanceType  = INSTANCE_WORLDMAT_AMBIENT_DIFFUSE;

bool Transparent : REInfoTransparent = true;


STD_VS_INSTANCE_OUTPUT VS(STD_VS_INSTANCE_INPUT Input)
{
	STD_VS_INSTANCE_OUTPUT Output = STD_VERTEX_SHADER_INSTANCE(Input);
	
	// use X as transparency factor
	Output.Misc.x = Input.Diff.g; // g is used as transparency
	
	float3 WorldPos = Output.WorldPos;
	float3 WorldNorm = Output.WorldNormal;
	
	float MoveFactor = 1.0f - Input.Diff.r;
	float WaveFactor = MoveFactor;
	float VertexOffset = Input.Pos.x + Input.Pos.y + Input.Pos.z;
	float3 WP = SFMatrixNonTranslationSummary(Input.WMat1, Input.WMat2, Input.WMat3);
	float OtherOffset = (frac(WP.x) + frac(WP.y) + frac(WP.z)) * 1.0f;
	float Dot = abs(dot(WIND_DIR, WorldNorm));
	float SinFactor = sin((TOTAL_TIME * VertexOffset * 1.5f) + OtherOffset);
	WorldPos += WorldNorm * SinFactor * WaveFactor * 1.0f * Dot * WIND_SPEED;
	WorldNorm = normalize(WorldNorm + (frac(VertexOffset) * 0.1f * WaveFactor));
	
	Output.WorldPos = WorldPos;
	Output.WorldNormal = WorldNorm;
	
	Output.Misc = Output.Pos;
	
	return Output;
}

STD_PS_OUTPUT_3 PS(STD_VS_INSTANCE_OUTPUT Input)
{
	STD_PS_OUTPUT_3 Out = (STD_PS_OUTPUT_3)0;
	float4 BaseTex = tex2D(DEFAULT_SAMPLER_2, Input.Tc);

	float3 Nn = normalize(Input.WorldNormal);
	float3 Vn = normalize(Input.WorldEyeVec);

	float4 SunLight = lightPixelSpecularRawAbs(Nn, Vn, TPM_SPECULAR_EXPONENT, TPM_SPECULAR_CONTRIBUTION );
	SunLight *= BaseTex.w;
	
	float4 DynamicLight = float4(0, 0, 0, 0);
#ifdef SHADER_DYNAMIC_LIGHTS_ENABLE
	[loop] for (int i=0; i<ActiveLightCount; i++)
	{
		DynamicLight += pointLightPixelSpecularRawAbs(Input.WorldPos, Nn,Vn,
			TPM_SPECULAR_EXPONENT, TPM_SPECULAR_CONTRIBUTION, LightParams[i]);
	}
	DynamicLight *= BaseTex.w;
#endif
		
	Out.Color.xyz = combineIllumination3(float4(Input.WorldPos, 1), Input.ZPos,Input.Fog, BaseTex, SunLight, DynamicLight);
	Out.Color.w = BaseTex.w;
	//Out.Effect = 0;

	// OffscreenFX
	Out.Color = ProcessOffscreenFXColor(Out.Color, Input.Misc);

	return Out;
}

technique T0
{
    pass P0
    { 
		STD_STATE;
		ColorWriteEnable = RED|BLUE|GREEN;

        AlphaBlendEnable = true;
        SrcBlend = SRCALPHA;
        DestBlend = INVSRCALPHA;
        
        ZEnable = true;
		ZWriteEnable = false;
	
		FogEnable = false;
        CullMode = NONE;
	
        VertexShader = compile vs_3_0 VS();
        PixelShader  = compile ps_3_0 PS();

    }
}
