// Note: Check light model
#include "stdstate.frag"
#include "matrix.frag"
#include "time.frag"
#include "texture.frag"
#include "instancing.frag"
#include "shadowmap.frag"
#include "ssao.frag"
#include "lighting.frag"
#include "std_vertex.frag"

#ifdef SHADER_DYNAMIC_OPAQUE_LIGHTS_ENABLE
#include "dynamic_lights.frag"
#endif

//Tell that this one is an instancing shader
bool InstancingShader : REInfoInstanceShader = true;
int InstanceVersion : REInfoInstanceType  = INSTANCE_WORLDMAT_AMBIENT_DIFFUSE;

STD_VS_INSTANCE_OUTPUT VS(STD_VS_INSTANCE_INPUT Input)
{
	STD_VS_INSTANCE_OUTPUT Out = STD_VERTEX_SHADER_INSTANCE(Input);
    Out.Tc.y += frac(TOTAL_TIME * ALPHA_METAL_TEXTURE_CYCLE_SPEED);
	float Time = abs(sin((TOTAL_TIME + Input.Pos.y + Input.Pos.x + Input.Pos.z) * 1.31f));
	Time = lerp(0.6f,1.0f,Time);
    Out.Glow = Time; 

    return Out;
}

STD_PS_OUTPUT_3 PS(STD_VS_INSTANCE_OUTPUT Input)
{
	STD_PS_OUTPUT_3 Output = (STD_PS_OUTPUT_3)0;
	float4 Color;
	float4 BaseTex = tex2D(DEFAULT_SAMPLER_2, Input.Tc);
	
	float3 Nn = normalize(Input.WorldNormal);
	float3 Vn = normalize(Input.WorldEyeVec);
	float3 Ln = -PLANET_LIGHTDIR_COMMON;

	float ldn = saturate(dot(Ln, Nn));

	float3 Reflect = reflect(Vn, Nn);

	float4 EnvMap = texCUBE(Environment_Sampler, Reflect);

	float tempdot = saturate(dot(Ln, Reflect));

	float Specular = pow(tempdot , ALPHAGLOWMETAL_SPECULAR_EXPONENT);

	float4 Lighting = saturate((ldn * PLANET_LIGHTCOLOR_COMMON) + ATMOSPHERE_AMBIENT);

	float4 BaseDiffuse = BaseTex * Lighting;
	BaseDiffuse.a = 0.0f;

	float3 OtherDiffuse = BaseDiffuse.xyz * EnvMap.xyz * 2.0f;

	float SpecularFactor = Specular * ALPHAGLOWMETAL_SPECULAR_CONTRIBUTION;

	float4 CombinedAlphaGlowMetalColor;
	CombinedAlphaGlowMetalColor.xyz = OtherDiffuse + SpecularFactor;
	CombinedAlphaGlowMetalColor.a = saturate((BaseTex.a * Input.Glow) + Specular) * (1.0 - Input.Fog);
	
	Color = lerp(BaseDiffuse, CombinedAlphaGlowMetalColor, BaseTex.a);
	
	
#ifdef SHADER_SHADOW_ENABLE
	float L;
	L = CalculateCascadedShadowDirLight(float4(Input.WorldPos, 1), Input.ZPos);
	Color = GetShadowValue(Color, L);
#endif

#ifdef SHADER_DYNAMIC_OPAQUE_LIGHTS_ENABLE
	[loop] for (int i=0; i<ActiveLightCount; i++)
	{
		Color.xyz += pointLightPixelSpecularRaw(Input.WorldPos, Nn, Vn,
			ALPHAGLOWMETAL_SPECULAR_EXPONENT, ALPHAGLOWMETAL_SPECULAR_CONTRIBUTION, LightParams[i]);
	}
#endif

	Color.xyz = lerp(Color.xyz, FOG_COLOR.xyz, Input.Fog);
		
	Output.Color = Color;
	//Output.Effect = 0;

#ifdef DEPTH_WRITE_ENABLE
	Output.Depth.xyz = Nn;
	Output.Depth.w = Input.ZPos.x / Input.ZPos.y;
#endif

#ifdef MATERIAL_WRITE_ENABLE
	Output.Material = float4(BaseTex.xyz, ALPHAGLOWMETAL_SPECULAR_CONTRIBUTION);
#endif
	
	return Output;

}

technique T0
{
    pass P0
    {
		STD_STATE;
    
		ColorWriteEnable = ALPHA|RED|BLUE|GREEN;

        AlphaTestEnable = false;

        AlphaBlendEnable = false;
        
        ZEnable = true;
		ZWriteEnable = true;
	
		FogEnable = true;
        CullMode = CCW;
	
        VertexShader = compile vs_3_0 VS();
        PixelShader  = compile ps_3_0 PS();
       

    }
}
