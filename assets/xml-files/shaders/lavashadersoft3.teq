#include "stdstate.frag"
#include "matrix.frag"
#include "windswing.frag"
#include "texture.frag"
#include "lighting.frag"
#include "stdio.frag"
#include "ssao.frag"
#include "lighting.frag"
#include "combine_illumination.frag"
#include "fake_reflections.frag"

//Tell that this one is transparent
bool Transparent : REInfoTransparent = true;

// Tell that this object is reflective
bool Reflective : REInfoReflective = true;

texture Texture0 : REPTexture0 = NULL;
texture Texture1 : REPTexture1 = NULL;
texture Texture2 : REPTexture2 = NULL;

sampler NormalSampler = sampler_state
{
	texture = (Texture1);
	AddressU = Wrap;
	AddressV = Wrap;
#ifdef SET_SAMPLERSTATE
    MipFilter = DEFAULT_MIPFILTER;
    MinFilter = USER_TEXTURE_FILTER;
    MagFilter = USER_TEXTURE_FILTER;
#endif	
};

sampler LavaTextureSampler = sampler_state
{
	texture = (Texture2);
	AddressU = Wrap;
	AddressV = Wrap;
#ifdef SET_SAMPLERSTATE
    MipFilter = DEFAULT_MIPFILTER;
    MinFilter = USER_TEXTURE_FILTER;
    MagFilter = USER_TEXTURE_FILTER;
#endif	
};


struct VS_OUTPUT
{
    float4 Pos  		: POSITION;
    float2 Tex  		: TEXCOORD0;
	float2 Tex2 		: TEXCOORD1;
	float2 Tex3 		: TEXCOORD2;
	float CamDist 		: TEXCOORD3;
	float4 ClipSpacePos : TEXCOORD4;
    float3 WorldPos   	: TEXCOORD5;
	float3 WorldEyeVec	: TEXCOORD6;
	float ZPos 			: TEXCOORD7;
    float Fog 			: FOG;
};

struct VS_INPUT
{
    float4 Pos	: POSITION;
    float3 Norm : Normal;
    float2 Tex	: TEXCOORD0;
};

VS_OUTPUT VS(VS_INPUT Input)
{
    VS_OUTPUT Out = (VS_OUTPUT)0;

	
    float4 WorldPos = mul(Input.Pos,WORLD_MATRIX);
	Out.Pos  = mul(WorldPos, VIEW_PROJECTION_MATRIX); 
	
    float3 L = -PLANET_LIGHTDIR_COMMON;

	float3 Dist = WorldPos - EYE_POS;
	float len =  abs(length(Dist));
	//now check this against farplane
	len = 1.0f - saturate(len/FOG_END);
	Out.CamDist = len;
	

    Out.Tex.x  = Input.Tex.x*LAVASOFT_BASETEXTURE_1_MULTIPLIER;
    Out.Tex.y  = Input.Tex.y*LAVASOFT_BASETEXTURE_1_MULTIPLIER - TOTAL_TIME*0.0035f * LAVASOFT_SPEED_FACTOR;
	Out.Tex3.x = Input.Tex.x*LAVASOFT_BASETEXTURE_2_MULTIPLIER;
	Out.Tex3.y = Input.Tex.y*LAVASOFT_BASETEXTURE_2_MULTIPLIER - TOTAL_TIME*0.01f * LAVASOFT_SPEED_FACTOR;
	Out.Tex2.x = Input.Tex.x*LAVASOFT_BASETEXTURE_3_MULTIPLIER;
	Out.Tex2.y = Input.Tex.y*LAVASOFT_BASETEXTURE_3_MULTIPLIER - TOTAL_TIME*0.0001f * LAVASOFT_SPEED_FACTOR;

	Out.WorldPos = WorldPos.xyz / WorldPos.w;
	Out.WorldEyeVec = normalize(Out.WorldPos - EyePos);
	Out.ZPos = Out.Pos.z;
	Out.ClipSpacePos = Out.Pos;
    Out.Fog = CalculateFog_3_0(Out.Pos.z);

    return Out;
}


STD_PS_OUTPUT_3 PS(VS_OUTPUT Input)
{
	STD_PS_OUTPUT_3 Out = (STD_PS_OUTPUT_3)0;

	float4 BaseTex = tex2D(DEFAULT_SAMPLER_2,Input.Tex);
	float4 NormalMap = tex2D(NormalSampler,Input.Tex2);
	float4 LavaTex = tex2D(LavaTextureSampler,Input.Tex3);

	float3 Normal_1 = 2.0f*(NormalMap-0.5f);
	float3 Normal_2 = 2.0f*(BaseTex - 0.5f);
	float3 Normal_3 = LavaTex.xyz;
	
	float Len = length(LavaTex.xyz);
	
	float Hn = normalize(Normal_1 + Normal_2);
	float Hdn = pow(max(0,dot(Hn,Normal_3)),8);
	
	Hdn = Hdn * (LavaTex.g+smoothstep(LavaTex.b,LavaTex.r,Hdn)*(1.0-LavaTex.g));
		
	float3 SpecularContrib = Hdn;
	
	float ldn = dot(Hn ,Normal_3);
	float mixer = 0.5 * (ldn + 1.0);
	
	float3 SurfColor = lerp(LAVASOFT_BASE_COLOR,LAVASOFT_BRIGHT_COLOR,mixer);
	float3 FinalTex = SurfColor*LavaTex + SpecularContrib * LAVASOFT_MEDIUM_COLOR * LAVASOFT_SPECULAR_FACTOR;
	
	float3 Diffuse = float3(0.5f,0.5f,0.5f);//PLANET_LIGHTCOLOR_COMMON/2.0f;
	float3 Ambient = float3(0.5f,0.5f,0.5f);
	
	float4 Vpaint = float4(1.0f,1.0f,1.0f,1.0f);
	float DepthTransparency = getDepthTransparency(Input.ClipSpacePos,Vpaint);
		
	Out.Color.xyz = combineIllumination3fakeNoAO(float4(Input.WorldPos,1), Input.ZPos,Input.Fog , FinalTex*2, Diffuse, Ambient, 0.2f);
	Out.Color.w = saturate(DepthTransparency*4);
	
	return Out;
}

technique T0
{
    pass P0
    {
		STD_STATE;

		ColorWriteEnable = ALPHA|RED|BLUE|GREEN;
		
		SeparateAlphaBlendEnable = true;
		SrcBlendAlpha = ZERO;
		DestBlendAlpha = INVSRCALPHA;
		
        AlphaBlendEnable = true;
        AlphaTestEnable = false;
		
		SrcBlend = SrcAlpha;
        DestBlend = InvSrcAlpha;
        
        ZEnable = true;
		ZWriteEnable = true;
	
		FogEnable = false;
        CullMode = NONE;
	
        VertexShader = compile vs_3_0 VS();
        PixelShader  = compile ps_3_0 PS();

    }
}
