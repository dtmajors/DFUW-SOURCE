#include "stdstate.frag"
float2 SampleOffsets[16];

sampler s0 : register(s0);

float4 SampleLumIter(in float2 vScreenPosition : TEXCOORD0) : COLOR
{
	float sum = 0;
	float max_sample = -1000.0f;
	for(int i = 0; i < 16; i++)
	{
		float samp = tex2D(s0, vScreenPosition + SampleOffsets[i]).r;
		sum += samp;
		if (samp > max_sample) max_sample = samp; // ---
	}

	return float4(max_sample, max_sample, max_sample, 1);
	
	// Divide the sum to complete the average
	sum /= 16;
	
	return float4(sum, sum, sum, 1.0f);
}

technique t0
{
    pass P0
    {
		STD_STATE;
		Lighting = false;
		AlphaBlendEnable = FALSE;
		AlphaTestEnable = FALSE;
		ColorWriteEnable = ALPHA|RED|BLUE|GREEN; 
		ZEnable = FALSE;
		ZWriteEnable = FALSE;
		CullMode = CCW;

		VertexShader = null;
        PixelShader  = compile ps_3_0 SampleLumIter();
    }
}