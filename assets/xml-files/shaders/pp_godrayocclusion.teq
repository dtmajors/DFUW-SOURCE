// godraysocclusion.teq
#include "planets.frag"
#include "matrix.frag"
#include "stdstate.frag"
#include "PP_ToneMappers.frag"
#include "RGBE.frag"
#include "texture.frag"

texture ZBuffer: REPZBufferTexture ; 
sampler2D ZBufferSampler = sampler_state
{
	Texture = <ZBuffer>;
	AddressU = CLAMP;
	AddressV = CLAMP;

    MinFilter = Point;
    MagFilter = Point;
};

float gaussianKernel[25] = {
	1 / 273.0, 4 / 273.0, 7 / 273.0, 4 / 273.0, 1 / 273.0,
	4 / 273.0, 16 / 273.0, 26 / 273.0, 16 / 273.0, 4 / 273.0,
	7 / 273.0, 26 / 273.0, 41 / 273.0, 26 / 273.0, 7 / 273.0,
	4 / 273.0, 16 / 273.0, 26 / 273.0, 16 / 273.0, 4 / 273.0,
	1 / 273.0, 4 / 273.0, 7 / 273.0, 4 / 273.0, 1 / 273.0
};

float4 Occlusion(in float2 tc : TEXCOORD0) : COLOR
{
	float2 textureDim = BackBufferParams.xy / 2;
	float2 texelSize = 1 / textureDim;
	
	float blurredDepth = 0.0;
	
	for (int j=-2; j<=2; j++) {
		for (int i=-2; i<=2; i++) {
			float2 texCoord = tc + texelSize * float2(i, j);
			float depth = tex2D(ZBufferSampler, texCoord).w;
			blurredDepth += depth * gaussianKernel[ (i + 2) + 5 * (j + 2)];
		}
	}
	
	blurredDepth = lerp(blurredDepth, tex2D(ZBufferSampler, tc).w, 0.6);
	
	blurredDepth = smoothstep(0.99999, 1, blurredDepth);
	
	return blurredDepth;
	
	/*
	float4 normalDepth = tex2D(ZBufferSampler, tc);
	if (normalDepth.w <= 0.0) clip(-1);
	return 0;
	*/
}

technique t0
{
    pass P0
    {
		STD_STATE;
		Lighting = false;
		AlphaBlendEnable = FALSE;
		AlphaTestEnable = FALSE;
		ColorWriteEnable = ALPHA|RED|BLUE|GREEN; 
		ZEnable = FALSE;
		ZWriteEnable = FALSE;
		CullMode = NONE;

		VertexShader = null;
        PixelShader  = compile ps_3_0 Occlusion();
    }
}