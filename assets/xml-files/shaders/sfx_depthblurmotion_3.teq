#include "stdstate.frag"
#include "matrix.frag"
#include "windswing.frag"
#include "texture.frag"
#include "stdio.frag"
#include "instancing.frag"
#include "ssao.frag"

#include "offscreenfx.frag"

bool InstancingShader : REInfoInstanceShader = true;
int InstanceVersion : REInfoInstanceType  = INSTANCE_WORLDMAT_DIFFUSE;


//float4 DiffMaterial : REPGlobalMaterialDiffuse = { 1.0f, 1.0f, 1.0f, 1.0f };

texture Texture0 : REPTexture0 = NULL;
texture Texture1 : REPTexture1 = NULL;


sampler DepthSampler = sampler_state
{
	texture = (Texture1);
    AddressU = WRAP;
    AddressV = WRAP;
#ifdef SET_SAMPLERSTATE
    MipFilter = DEFAULT_MIPFILTER;
    MinFilter = USER_TEXTURE_FILTER;
    MagFilter = USER_TEXTURE_FILTER;
#endif	
};



struct VS_INPUT
{
    float4 Pos	: POSITION;
    float3 Norm : Normal;
    float4 Diff : COLOR0;
    float2 Tex	: TEXCOORD0;
	//Instancing data	
	float4 DiffuseMaterialColor : COLOR1;
	float4 WMat1 : TEXCOORD5;
	float4 WMat2 : TEXCOORD6;
	float4 WMat3 : TEXCOORD7;
	float4 WMat4 : TEXCOORD8;
	
};

struct VS_OUTPUT
{
    float4 Pos  : POSITION;
    float4 Diff : COLOR0;
    float2 Tex  : TEXCOORD0;
    float2 Tex2 : TEXCOORD1;
    float2 Tex3 : TEXCOORD2;
    float2 Tex4 : TEXCOORD3;
    float4 WorldPos : TEXCOORD4;
	float3 WorldNorm : TEXCOORD5;
	float4 ClipSpace : TEXCOORD6;
    float Fog : FOG;
};

bool Transparent : REInfoTransparent = true;


VS_OUTPUT VS(VS_INPUT Input)
{
    VS_OUTPUT Out = (VS_OUTPUT)0;

	SFMatrix WMat;
	WMat[0] = Input.WMat1;
	WMat[1] = Input.WMat2;
	WMat[2] = Input.WMat3;
	WMat[3] = Input.WMat4;
	
	
	float4 DiffMaterial = Input.DiffuseMaterialColor;
	

	float4 Pos = Input.Pos;
	float3 AllMin = abs(Input.Pos - getBBCenter());
	
	float YVal = getYMin(Input.Pos.y);
	//float3 Norm = float3(Input.Norm.x,0,Input.Norm.z);
	Pos.x += Input.Norm.x * sin(TOTAL_TIME*0.23f) * AllMin.x * YVal;
	Pos.z += Input.Norm.z * sin(TOTAL_TIME*0.31f) * AllMin.z * YVal;
	Pos.y += Input.Norm.y * sin(TOTAL_TIME*0.13f) * AllMin.y * YVal;

    //SFMatrix WVP = mul(WORLD_MATRIX,VIEW_PROJECTION_MATRIX);
	
	float4 WorldPos = mul(Pos,WMat);
	float3 WorldNorm = mul(Input.Norm,(float3x3)WMat);

    Out.Pos  = mul(WorldPos, VIEW_PROJECTION_MATRIX);             // position (projected)
	Out.WorldPos = WorldPos;
	Out.WorldNorm = WorldNorm;

    
    Out.Diff = DiffMaterial;
    Out.Diff.w = (Input.Diff.g)*DiffMaterial.w;
    
    //float Scale = 1.0f + Input.Diff.g*SIN_TIME;
    
	Out.Tex = Input.Tex;
	Out.Tex.x  = Input.Tex.x; 
    Out.Tex.y  = Input.Tex.y + frac(TOTAL_TIME*0.13f);
	Out.Tex2.x = Input.Tex.x; 
	Out.Tex2.y = Input.Tex.y - frac(TOTAL_TIME*0.09f);
    
	Out.Tex4.x  = Input.Tex.x + frac(TOTAL_TIME*0.033f);
    Out.Tex4.y  = Input.Tex.y + frac(TOTAL_TIME*0.057f);
	Out.Tex3 = Out.Tex;

    Out.Fog = CalculateFog_3_0(Out.Pos.z);
	Out.ClipSpace = Out.Pos;

    return Out;
}


PS_OUTPUT_DEPTH_3 PS(VS_OUTPUT Input)
{
	
	PS_OUTPUT_DEPTH_3 Out = (PS_OUTPUT_DEPTH_3)0;
	float4 BaseTex = tex2D(DEFAULT_SAMPLER_2,Input.Tex);
	float4 BaseTex2 = tex2D(DEFAULT_SAMPLER_2,Input.Tex2);
	float4 BaseTex3 = tex2D(DEFAULT_SAMPLER_2,Input.Tex4);
	float DepthTex = tex2D(DepthSampler,Input.Tex3).x;
	Out.Color = BaseTex * BaseTex2 * Input.Diff;
	Out.Color.w = BaseTex3.w * DepthTex;
	//Out.Color.w = 1.0f;
	
	Out.Color.xyz = lerp(Out.Color.xyz,0,Input.Fog);
	
	float4 NewPos = Input.WorldPos;
	NewPos.xyz += DepthTex * Input.WorldNorm * SIN_TIME;
	float4 OutPos = mul(NewPos,VIEW_PROJECTION_MATRIX);
	Out.Depth = OutPos.z/OutPos.w;
	
	//Out.Effect = Out.Color.w*0.01f;
	
#ifdef SSAO_ENABLE
	Out.SSAO_Depth = SSAO_NO_EFFECT;
#endif	
	
	// OffscreenFX
	Out.Color = ProcessOffscreenFXColor(Out.Color, Input.ClipSpace);
	
	return Out;
}



//
//

technique T0
{
    pass P0
    {
		STD_STATE;
		ColorWriteEnable = RED|BLUE|GREEN;

        AlphaBlendEnable = true;
        AlphaTestEnable = false;
        SrcBlend = SrcAlpha;
        DestBlend = One;//InvSrcAlpha;
        
        ZEnable = true;
		ZWriteEnable = false;
	
		FogEnable = false;
        //CullMode = CCW;
        CullMode = NONE;
	
        VertexShader = compile vs_3_0 VS();
        PixelShader  = compile ps_3_0 PS();
    }
}
