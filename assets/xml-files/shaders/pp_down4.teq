};


float2 TexelCoordsFilter[KernelSize];
*/


static const int KernelSize = 4;

float2 PixelCoordsFilter[KernelSize] =
{

    { 0.5,   0.5 },
    { 0.5,  -0.5 },
    {-0.5,   0.5 },
    {-0.5,  -0.5 },
};


float2 TexelCoordsFilter[KernelSize];




float4 DownFilter( in float2 Tex : TEXCOORD0 ) : COLOR0
{
    float4 Color = 0;

    for (int i = 0; i < KernelSize; i++)
    {
        Color += tex2D( SrcColorSampler, Tex + TexelCoordsFilter[i].xy );
    }

    return Color / KernelSize;
}

float4 DownFilterSimple( in float2 Tex : TEXCOORD0 ) : COLOR0
{
    return tex2D( SrcColorSampler, Tex);
}



//
//

technique DownSample
<
  float ScaleX = 0.25f;
  float ScaleY = 0.25f;
>
{
    pass P0
    {
		STD_STATE;
    	Texture[1] = NULL;
    
        Lighting       = false;
        AlphaBlendEnable = FALSE;
        AlphaTestEnable = FALSE;
	ColorWriteEnable = ALPHA|RED|BLUE|GREEN; 
        ZEnable = FALSE;
	ZWriteEnable = FALSE;
	CullMode = CCW;
   
        VertexShader = null;
        PixelShader = compile ps_2_a DownFilterSimple();
        ZEnable = false;
    
    }
}
