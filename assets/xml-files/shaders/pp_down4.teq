//DownSample 4
#include "stdstate.frag"




texture SourceColor : REPTextureSourceColor;


sampler2D SrcColorSampler =
sampler_state
{
    Texture = <SourceColor>;
    AddressU = Clamp;
    AddressV = Clamp;
/*#ifdef SET_SAMPLERSTATE
    MinFilter = Linear;
    MagFilter = Linear;
#endif	*/
};

/*
static const int KernelSize = 16;

float2 PixelCoordsFilter[KernelSize] =
{
    { 1.5,  -1.5 },
    { 1.5,  -0.5 },
    { 1.5,   0.5 },
    { 1.5,   1.5 },

    { 0.5,  -1.5 },
    { 0.5,  -0.5 },
    { 0.5,   0.5 },
    { 0.5,   1.5 },

    {-0.5,  -1.5 },
    {-0.5,  -0.5 },
    {-0.5,   0.5 },
