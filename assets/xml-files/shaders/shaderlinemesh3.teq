
#include "stdstate.frag"
#include "fog.frag"
#include "matrix.frag"
#include "windswing.frag"
#include "texture.frag"


float4 DiffMaterial : REPGlobalMaterialDiffuse = { 1.0f, 1.0f, 1.0f, 1.0f };
float4 AmbMaterial : REPGlobalMaterialAmbient = { 1.0f, 1.0f, 1.0f, 1.0f };


struct VS_OUTPUT
{
    float4 Pos  : POSITION;
    float2 Tex	: TEXCOORD0;
    float  Fog  : FOG;
};


struct VS_INPUT
{
    float4 Pos	: POSITION;
    float2 Tex	: TEXCOORD0;
};




VS_OUTPUT VS(VS_INPUT Input)
{
    VS_OUTPUT Out = (VS_OUTPUT)0;

    Out.Pos = mul(Input.Pos,VIEW_PROJECTION_MATRIX); 
    
    Out.Tex = Input.Tex;
    
	Out.Tex.x  = Input.Tex.x - frac(TOTAL_TIME* AmbMaterial.x ) + AmbMaterial.z ;
	Out.Tex.y  = Input.Tex.y - frac(TOTAL_TIME* AmbMaterial.y ) + AmbMaterial.w ;
	
    Out.Fog = CalculateFog_3_0(Out.Pos.z);

    return Out;
}


float4 PS(VS_OUTPUT Input) : COLOR
{
	float4 BaseTex = tex2D(DEFAULT_SAMPLER_2,Input.Tex);
	float4 Color = BaseTex* DiffMaterial;
	Color.xyz = lerp(Color.xyz,FOG_COLOR.xyz,Input.Fog);
	return Color;
	
}



technique T0
{
    pass P0
    {
		STD_STATE;
    	FogEnable = false;

        AlphaTestEnable = FALSE;
        
        AlphaBlendEnable = TRUE;
        SrcBlend = SRCALPHA;
        DestBlend = INVSRCALPHA;

        ZEnable = TRUE;
		ZWriteEnable = FALSE;
       	CullMode = NONE;
        
		ColorWriteEnable = RED|BLUE|GREEN; 
        
    
    	VertexShader = compile vs_3_0 VS();
        PixelShader = compile ps_3_0 PS();
    }    
    
}


