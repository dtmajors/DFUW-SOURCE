#include "stdstate.frag"
#include "stdio.frag"
#include "stdio.frag"
#include "matrix.frag"
#include "spenebump.frag"
#include "stdio.frag"
#include "time.frag"
#include "texture.frag"
#include "ssao.frag"
#include "lighting.frag"
#include "combine_illumination.frag"

#ifdef SHADER_DYNAMIC_OPAQUE_LIGHTS_ENABLE
#include "dynamic_lights.frag"
#endif

//Tell that this one is an instancing shader
bool InstancingShader : REInfoInstanceShader = false;

struct VS_INPUT
{
    float4 Pos	: POSITION;
    float3 Norm : Normal;
};


struct VS_OUTPUT
{
    float4  Pos     : POSITION;
    float4  Color    : TEXCOORD0;
    float  Glow    			: TEXCOORD1;
    float  AmbientGlow    	: TEXCOORD2;
    float3 WorldPos   		: TEXCOORD3;
	float3 WorldNormal		: TEXCOORD4;
	float3 WorldEyeVec		: TEXCOORD5;
	float2 ZPos 				: TEXCOORD6;
    float   Fog	    : FOG;
};


VS_OUTPUT VS(VS_INPUT Input)
{
   VS_OUTPUT Out = (VS_OUTPUT)0;

	SFMatrix WMat = WORLD_MATRIX;

   	float3 NewPos = SFVectorRotateY(Input.Pos.xyz, TOTAL_TIME * TEXT_3D_ROTATE_CW);
	//NewPos.x += sin(TOTAL_TIME + Input.Pos.x)*3.1f;
	NewPos.y += sin(TOTAL_TIME + Input.Pos.x)*TEXT_3D_Y_TEXT_DEVIATION;
	NewPos.z += sin(TOTAL_TIME + Input.Pos.x)*TEXT_3D_Z_TEXT_DEVIATION;
	NewPos *= TEXT_3D_EXTRA_SCALE;
	float3 NewNorm = SFVectorRotateY(Input.Norm, TOTAL_TIME * TEXT_3D_ROTATE_CW);
	
	float4 RealPos = float4(NewPos, 1.0f);
    float3 WorldNorm = normalize(mul(NewNorm,(float3x3) WMat));

	Out.WorldPos = mul( RealPos , WORLD_MATRIX ).xyz ; 
	Out.WorldNormal = mul(NewNorm, (float3x3)WorldMatrix);
	Out.WorldEyeVec = normalize((Out.WorldPos - EyePos));

	Out.Pos  = mul( float4(Out.WorldPos,1.f) , VIEW_PROJECTION_MATRIX);             // position (projected)
	Out.ZPos = Out.Pos.zw;

	float Lerp = abs(sin((TOTAL_TIME + (Input.Pos.y * Input.Pos.x + Input.Pos.y * Input.Pos.x + Input.Pos.z)) * 0.73f));
	
    Out.Color  = lerp(TEXT_3D_START_COLOR, TEXT_3D_END_COLOR, Lerp);
    Out.Fog = CalculateFog_3_0(Out.Pos.z);   

	Out.AmbientGlow = abs(sin((TOTAL_TIME*1.2f + (Input.Pos.y))))*0.25f;
    
	float Time = abs(sin((TOTAL_TIME+Input.Pos.y + Input.Pos.x + Input.Pos.z)*0.31f));
    Out.Glow = Time*Time*Time*Time; 
   
    
    return Out;
}

STD_PS_OUTPUT_3 PS(VS_OUTPUT Input)
{
	STD_PS_OUTPUT_3 Output = (STD_PS_OUTPUT_3)0;
	float4 BaseTex = Input.Color;
	
	float3 Nn = normalize(Input.WorldNormal);
	float3 Vn = normalize(Input.WorldEyeVec);
	
	float4 SunLight = lightPixelSpecularDiffuseEnvironmentRaw(Nn, Vn, -PLANET_LIGHTDIR_COMMON, TEXT_3D_SPECULAR_EXPONENT, TEXT_3D_SPECULAR_CONTRIBUTION);
	

	float4 DynamicLight = float4(0, 0, 0, 0);
#ifdef SHADER_DYNAMIC_OPAQUE_LIGHTS_ENABLE
	[loop] for (int i=0; i<ActiveLightCount; i++)
	{
		DynamicLight += pointLightPixelSpecularRaw(Input.WorldPos, Nn, Vn, 
			TEXT_3D_SPECULAR_EXPONENT, TEXT_3D_SPECULAR_CONTRIBUTION, LightParams[i]);
	}
#endif

	DynamicLight.xyz += Input.AmbientGlow;

	Output.Color.xyz = combineIllumination3(float4(Input.WorldPos, 1), Input.ZPos, Input.Fog, BaseTex.xyz, SunLight, DynamicLight);
	Output.Color.w = saturate((BaseTex.w * Input.Glow) + (SunLight.w+DynamicLight.w)/TEXT_3D_SPECULAR_CONTRIBUTION);
		
	//Output.Effect = 0;
	
#ifdef DEPTH_WRITE_ENABLE
	Output.Depth.xyz = Nn;
	Output.Depth.w = Input.ZPos.x / Input.ZPos.y;
#endif

#ifdef MATERIAL_WRITE_ENABLE
	Output.Material = float4(BaseTex.xyz, TEXT_3D_SPECULAR_CONTRIBUTION);
#endif
	
	return Output;

}





//
//

technique T0
{
    pass P0
    {
		STD_STATE;
    
		ColorWriteEnable = ALPHA|RED|BLUE|GREEN;

        AlphaTestEnable = false;

        AlphaBlendEnable = false;
        
        ZEnable = true;
		ZWriteEnable = true;
	
		FogEnable = false;
        CullMode = CCW;
	
        VertexShader = compile vs_3_0 VS();
        PixelShader  = compile ps_3_0 PS();
       

    }
}
