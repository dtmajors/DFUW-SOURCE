//DownSample 2x

#include "stdstate.frag"
#include "HDRLUtils.frag"


texture SourceColor : REPTextureSourceColor;
const float DirtRemove;
float InvDirtRemove;

sampler2D SrcColorSampler =
sampler_state
{
    Texture = <SourceColor>;
    AddressU = Clamp;
    AddressV = Clamp;
    MinFilter = Linear;
    MagFilter = Linear;
    MipFilter = Linear;
};



static const int KernelSize = 4;

float2 PixelCoordsFilter[KernelSize] =
{

    { 0.5,   0.5 },
    { 0.5,  -0.5 },
    {-0.5,   0.5 },
    {-0.5,  -0.5 },
};


float2 TexelCoordsFilter[KernelSize];




float4 DownFilter( in float2 Tex : TEXCOORD0 ) : COLOR0
{
    float4 Color = 0;

    for (int i = 0; i < KernelSize; i++)
    {
        Color += tex2D( SrcColorSampler, Tex + TexelCoordsFilter[i].xy );
    }

    return Color / KernelSize;
}

float4 DownFilterAlpha( in float2 Tex : TEXCOORD0 ) : COLOR0
{
    float4 Color = 0;

    //float3 SourceColor = tex2D( SrcColorSampler, Tex ).xyz;
    float3 DotVector = LUMINANCE_VECTOR * 0.8f;

    for (int i = 0; i < KernelSize; i++)
    {
    	float4 TempColor = tex2D( SrcColorSampler, Tex + TexelCoordsFilter[i].xy );
    	float Multiplier;
        if (TempColor.a > 0.5f)
        	Multiplier = TempColor.a * 2.0f;
        else
        	Multiplier = 1.0f;
           

        Color.xyz += TempColor.xyz * (TempColor.a )*(Multiplier);
        //Color.xyz += SourceColor.xyz * dot(TempColor.xyz , LUMINANCE_VECTOR);
        //Color.xyz += TempColor.xyz * dot(TempColor.xyz , SourceColor.xyz);
        Color.xyz += TempColor.xyz * dot(TempColor.xyz, DotVector);
        //Color.xyz += TempColor.xyz * dot(TempColor.xyz , LUMINANCE_VECTOR_GREEN);
        //Color.xyz += dot(TempColor.xyz , LUMINANCE_VECTOR)*0.5f;
        Color.a += TempColor.a;
    }

    //return Color / KernelSize;
    Color /= KernelSize;
    //Color.xyz += tex2D( SrcColorSampler, Tex ).xyz * dot(tex2D( SrcColorSampler, Tex ).xyz, LUMINANCE_VECTOR) * 1.2f;
    return Color;
}
