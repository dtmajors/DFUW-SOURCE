float4 DownFilterAlpha1x( in float2 Tex : TEXCOORD0 ) : COLOR0
{
    float4 Color = 0;

    float4 TempColor = tex2D( SrcColorSampler, Tex );
    float Multiplier;
    
         //if (TempColor.a > 0.5f)
        //	Multiplier = TempColor.a*2.0f;
       // else
       // 	Multiplier = 1.0f;
           

//        Color.xyz = TempColor.xyz * (TempColor.a )*Multiplier;
        Color.xyz = TempColor.xyz * (TempColor.a )*2;
        //try to remove dirty pixels
        Multiplier = saturate(dot(TempColor.xyz, LUMINANCE_VECTOR) - DirtRemove);
        //Multiplier = Multiplier * InvDirtRemove;
        
