*/


float4 DownFilterAlpha1x( in float2 Tex : TEXCOORD0 ) : COLOR0
{
    float4 Color = 0;

    float4 TempColor = tex2D( SrcColorSampler, Tex );

    float Multiplier;
/*    
         if (TempColor.a > 0.5f)
        	Multiplier = TempColor.a*2.0f;
        else
        	Multiplier = 1.0f;
           
*/
        Color.xyz = TempColor.xyz * (TempColor.a )*2;
        //Color = TempColor * (TempColor.a ) * 2;

        //Multiplier = saturate(dot(TempColor.xyz, LUMINANCE_VECTOR) - 0.2f);
        //Multiplier = dot(TempColor.xyz, LUMINANCE_VECTOR);
        //Multiplier -=  DirtTest;
        //Multiplier = Multiplier * InvDirtRemove;
        //Color.xyz += saturate(TempColor.xyz * Multiplier);// * 2;
        //Color.xyz += TempColor.xyz * Multiplier * 2;

        Color.a = TempColor.a;

    return Color;
}


//
//

technique DownSample
<
  float ScaleX = 0.5f;
  float ScaleY = 0.5f;
>
{
    pass P0
    {
		STD_STATE;
    	Texture[1] = NULL;
    
        Lighting       = false;
        AlphaBlendEnable = FALSE;
        AlphaTestEnable = FALSE;
        ZEnable = FALSE;
	ZWriteEnable = FALSE;
	CullMode = CCW;
        
   
        VertexShader = null;
        //PixelShader = compile ps_2_a DownFilterAlpha();
        PixelShader = compile ps_2_a DownFilterAlpha1x();
        ZEnable = false;
    
    }
}
