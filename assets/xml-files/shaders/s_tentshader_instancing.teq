
#include "stdstate.frag"
#include "windswing.frag"
#include "texture.frag"

#include "instancing.frag"
#include "shadowmap.frag"


bool InstancingShader : REInfoInstanceShader = true;
int InstanceVersion : REInfoInstanceType  = INSTANCE_WORLDMAT_AMBIENT_DIFFUSE;


struct VS_INPUT
{
    float4 Pos	: POSITION;
    float3 Norm : Normal;
	float4 Diff : COLOR0;
    float2 Tex	: TEXCOORD0;
	//Instancing data
	float4 WMat1 : TEXCOORD5;
	float4 WMat2 : TEXCOORD6;
	float4 WMat3 : TEXCOORD7;
	float4 WMat4 : TEXCOORD8;
};



VS_SHADOWMAP_OUTPUT VS(VS_INPUT Input)
{
    VS_SHADOWMAP_OUTPUT Out = (VS_SHADOWMAP_OUTPUT)0;

	SFMatrix WMat;
	WMat[0] = Input.WMat1;
	WMat[1] = Input.WMat2;
	WMat[2] = Input.WMat3;
	WMat[3] = Input.WMat4;
	

    float3 WorldNorm = normalize(mul(Input.Norm,(float3x3)WMat));
    float3 WorldPos = mul(Input.Pos,WMat);
	
	float WaveFactor = 1.0f - Input.Diff.r;
	float VertexOffset = Input.Pos.x + Input.Pos.y + Input.Pos.z;
	float3 WP = SFMatrixNonTranslationSummary(WMat);
	float OtherOffset = (frac(WP.x) + frac(WP.y) + frac(WP.z))*1.0f;

	float Dot = abs(dot(WIND_DIR,WorldNorm));
	
	float SinVal = sin((TOTAL_TIME * VertexOffset * 0.3f) + OtherOffset );
	
	WorldPos += WorldNorm * SinVal * WaveFactor * 3.0f * Dot * WIND_SPEED;
	

    Out.Pos  = mul(float4(WorldPos,1.0f), SHADOW_VIEW_PROJECTION_MATRIX);             // position (projected)
	Out.ScreenPos = Out.Pos;
    
    Out.Tex  = Input.Tex;

    return Out;
}


//
//

technique T0
{
    pass P0
    {
		STD_STATE;
		ColorWriteEnable = ALPHA|RED|BLUE|GREEN;

        AlphaBlendEnable = false;
        AlphaTestEnable = false;
        
        ZEnable = TRUE;
		ZWriteEnable = TRUE;
	
		FogEnable = false;
        CullMode = CW;
	
        VertexShader = compile vs_3_0 VS();
        PixelShader  = compile ps_3_0 ShadowMapPS();
    }
}
