
#include "stdstate.frag"
#include "matrix.frag"
#include "spenebump.frag"
#include "sampler.frag"
#include "fog.frag"
#include "atmosphere.frag"
#include "alphaHDRL.frag"



// Matrix Pallette
static const int MAX_MATRICES = 26;
float4x3    mWorldMatrixArray[MAX_MATRICES] : REAnimWorldMatrixArray;

texture Tex0 : REPTextureDirect;
float4 DiffMaterial : REPGlobalMaterialDiffuse = { 1.0f, 1.0f, 1.0f, 1.0f };
float PowerMaterial : REPGlobalMaterialPower = 0.0f;


///////////////////////////////////////////////////////

struct VS_INPUT
{
    float4  Pos             : POSITION;
    float4  BlendWeights    : BLENDWEIGHT;
    float4  BlendIndices    : BLENDINDICES;
    float3  Normal          : NORMAL;
    float3  Tex0            : TEXCOORD0;
};

