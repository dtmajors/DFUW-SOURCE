#include "stdstate.frag"
#include "stdio.frag"
#include "fog.frag"
#include "matrix.frag"
#include "texture.frag"
#include "instancing.frag"
#include "lighting.frag"
#include "combine_illumination.frag"

bool InstancingShader : REInfoInstanceShader = true;
int InstanceVersion : REInfoInstanceType  = INSTANCE_WORLDMAT_AMBIENT_DIFFUSE;

struct VS_OUTPUT
{
    float4  Pos     	: POSITION;
    float2  Tex0		: TEXCOORD0;
    float3 WorldNormal	: TEXCOORD1;
    float3 WorldEyeVec	: TEXCOORD2;
	float2 ZPos			: TEXCOORD3;
	float3 WorldPos		: TEXCOORD4;
    float   Fog			: FOG;
};


VS_OUTPUT VS(STD_VS_INSTANCE_INPUT Input)
{
   VS_OUTPUT Out = (VS_OUTPUT)0;
   
	SFMatrix WMat;
	WMat[0] = Input.WMat1;
	WMat[1] = Input.WMat2;
	WMat[2] = Input.WMat3;
	WMat[3] = Input.WMat4;


    float4x4 WorldView = mul(WMat, VIEW_MATRIX);

    float3 L = -PLANET_LIGHTDIR_COMMON;


    float4 PView = mul(Input.Pos, WorldView);  // position (view space)
    Out.WorldNormal = normalize(mul(Input.Norm, (float3x3)WMat)); // normal (world space)
	
    float4 WorldPos = mul(Input.Pos,WMat);
	Out.WorldPos = WorldPos.xyz / WorldPos.w;	
    Out.Pos  = mul(PView, PROJECTION_MATRIX);             // position (projected)
	Out.WorldEyeVec = normalize(WorldPos.xyz - EyePos);

    Out.Tex0  = Input.Tex;
    Out.Fog = CalculateFog_3_0(Out.Pos.z);   
	
	Out.ZPos.xy = Out.Pos.zw;
    
    return Out;
}



STD_PS_OUTPUT_3 PS(VS_OUTPUT Input) : COLOR
{
	STD_PS_OUTPUT_3 Output = (STD_PS_OUTPUT_3) 0;

	float4 BaseTex = tex2D(DEFAULT_SAMPLER_2,Input.Tex0);
	
	float ReflectionHint = BaseTex.a;

	float3 Nn = normalize(Input.WorldNormal);
	float3 Vn = normalize(Input.WorldEyeVec);
	float3 Ln = -PLANET_LIGHTDIR_COMMON;
	
	float3 Reflect = reflect(Vn,Nn);
	
	float tempdot = saturate(dot(Ln,Reflect));
	float Specular = pow(tempdot , EYE_SPECULAR_EXPONENT) * ReflectionHint;
	
	/*
	float3 DiffuseFactor = BaseTex.xyz * ldn;
	float3 SpecularFactor = Specular * EYE_SPECULAR_CONTRIBUTION;
	
	float ldn = lerp(1.0f,saturate(dot(Ln,Nn)),EYE_DIFFUSE_CONTRIBUTION);
	float4 SunLColor.xyz = DiffuseFactor + SpecularFactor;
	
	Color.a = Specular/4;*/
	
	BaseTex.xyz += Specular * EYE_SPECULAR_CONTRIBUTION;
	
	float4 Color;
	Color.xyz = combineIllumination3amb(Input.WorldPos, Input.Fog, BaseTex.xyz, 0.4f);
	Color.w = Specular;
	
	Output.Color = Color;
	
#ifdef MATERIAL_WRITE_ENABLE
	Output.Material = float4(BaseTex.xyz, 0);
#endif
	
#ifdef DEPTH_WRITE_ENABLE
	Output.Depth.xyz = Nn;
	Output.Depth.w = Input.ZPos.x / Input.ZPos.y;
#endif
	
	return Output;
}

technique T0
{
    pass P0
    {
		STD_STATE;
    
		ColorWriteEnable = ALPHA|RED|BLUE|GREEN;
        
        AlphaTestEnable = false;
        AlphaBlendEnable = false;
        ZEnable = TRUE;
		ZWriteEnable = TRUE;
	
		FogEnable = false;
        CullMode = CCW;
	
        VertexShader = compile vs_3_0 VS();
        PixelShader  = compile ps_3_0 PS();
    }
}
