
#include "stdstate.frag"
#include "fog.frag"
#include "matrix.frag"
#include "windswing.frag"
#include "texture.frag"
#include "light_constants.frag"


float4 DiffMaterial : REPGlobalMaterialDiffuse = { 1.0f, 1.0f, 1.0f, 1.0f };
float PowerMaterial : REPGlobalMaterialPower = 0.0f;


struct VS_OUTPUT
{
    float4 Pos  : POSITION;
    float4 Diff : COLOR0;
    float2 Tex  : TEXCOORD0;
    float  Glow    			: TEXCOORD1; 
    float3 WorldPos 	:TEXCOORD2; 
	float Fog : FOG;
};


struct VS_INPUT
{
    float4 Pos				: POSITION;
    float3 Norm 			: Normal;
    float4 Diff 			: COLOR0; 
    float2 Tex				: TEXCOORD0;
};



VS_OUTPUT VS(VS_INPUT Input)
{
    VS_OUTPUT Out = (VS_OUTPUT)0;


    //SFMatrix WVP = mul(WORLD_MATRIX,VIEW_PROJECTION_MATRIX);
	SFMatrix WVP = mul(WORLD_MATRIX,mul(VIEW_MATRIX,PROJECTION_MATRIX));

	float4 InPos = Input.Pos ; 
	InPos.y -= 0.5f ; 
	InPos.xyz *= 120;
	
    Out.Pos  = mul( InPos , WVP);
	InPos.xyz /= 120;
	Out.WorldPos = mul( InPos , WORLD_MATRIX ) ; 
		
   
    //Out.Diff = DiffMaterial;
    Out.Diff.w = Input.Diff.g;
	//Out.Diff = Input.Diff.r;
    
   
    Out.Tex  = Input.Tex;
    //Out.Tex.y += frac(TOTAL_TIME*0.005f);
	float Time = sin((TOTAL_TIME+Input.Pos.y + Input.Pos.x + Input.Pos.z)*STARDOME_PULSE_FREQUENCY_1);
    Out.Glow = pow(Time,3) ; //STARDOME_TIME_POW);
	
    Out.Fog = saturate( InPos.y);

    return Out;
}


float4 PS(VS_OUTPUT Input) : COLOR
{
	float4 Out = (float4)0;
	float4 BaseTex = tex2D(DEFAULT_SAMPLER_2,Input.Tex);
	//Out = BaseTex.xyz*DiffMaterial.xyz;
	//Out = Input.Diff;
	//Out = DiffMaterial.a;
	//BaseTex.xyz = saturate(BaseTex.xyz +  Input.Glow * BaseTex.a);
	//Out = FOG_COLOR+BaseTex * Input.Diff.w * BaseTex.r * DiffMaterial.a;
	float avg =  BaseTex.xyz ; 
	float3 StarColor = float3(1.5f , 1.5f ,1.5f ) + Input.Glow * BaseTex.a ; 
	Out = float4( StarColor , 0.2f * avg * Input.WorldPos.y  )  ;
	return Out;
}



//
//

technique T0
{
    pass P0
    {
		STD_STATE;
    
		ColorWriteEnable = RED|BLUE|GREEN;

        AlphaBlendEnable = TRUE;
        AlphaTestEnable = FALSE;
		SrcBlend = SRCALPHA;
		DestBlend = INVSRCALPHA;
        
        ZEnable = TRUE;
		ZWriteEnable = FALSE;
	
		FogEnable = FALSE;
        CullMode = CW;
	
        VertexShader = compile vs_1_1 VS();
        PixelShader  = compile ps_2_a PS();

    }
}
