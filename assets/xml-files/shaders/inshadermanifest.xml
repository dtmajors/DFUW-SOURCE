
<!--

	Use DisablePrecompiled="true", as an attribute of "ConfigOption". This will disable
	precompiled shaders for this option, reducing total configurations. In this configuration
	shaders will be loaded from source.

-->

<ShaderManifest>
	<ConfigUnits>
		<ConfigUnit Name="Shadow enable">
			<ConfigOption Name="SH0"/>
			<ConfigOption Name="SH1" MacroName="SHADER_SHADOW_ENABLE" Value="1"/>
		</ConfigUnit>
		
		<ConfigUnit Name="Shadow smoothing quality">
			<ConfigOption Name="SQ0" MacroName="SHADER_SHADOW_SMOOTHING_QUALITY" Value="1"/>
			<ConfigOption Name="SQ1" MacroName="SHADER_SHADOW_SMOOTHING_QUALITY" Value="2"/>
			<ConfigOption Name="SQ2" MacroName="SHADER_SHADOW_SMOOTHING_QUALITY" Value="3"/>
		</ConfigUnit>
		
		<ConfigUnit Name="Quality post effects enable">
			<ConfigOption Name="PP0" />
			<ConfigOption Name="PP1" MacroName="SHADER_PP_QUALITY" Value="1"/>
		</ConfigUnit>
		
		<ConfigUnit Name="Texture filtering">
			<ConfigOption Name="TF1" MacroName="USER_TEXTURE_FILTER" Value="LINEAR"/>
			
			<ConfigOption Name="TF2" MacroName="USER_TEXTURE_FILTER" Value="ANISOTROPIC"/>
		</ConfigUnit>
		
		<ConfigUnit Name="God rays enable">
			<ConfigOption Name="GR0" />
			<ConfigOption Name="GR1" MacroName="SHADER_PP_GOD_RAYS" Value="1"/>
		</ConfigUnit>
		
		<ConfigUnit Name="Shader quality">
			<ConfigOption MacroName="LOW_SHADER_QUALITY" Name="SQ0" Value="1" />
			<ConfigOption Name="SQ1" />
		</ConfigUnit>
		
		<!-- Single option units will always define their macros -->
		<ConfigUnit Name="Voxel lighting enable">
			<ConfigOption Name="VX1" MacroName="VOXEL_LIGHTING_ENABLE" Value="1"/>
		</ConfigUnit>
		
		<ConfigUnit Name="Dynamic lights enable">
			<ConfigOption Name="DL1" MacroName="SHADER_DYNAMIC_LIGHTS_ENABLE" Value="1"/>
		</ConfigUnit>
		
		<ConfigUnit Name="Deferred lights enable">
			<ConfigOption Name="DF1" MacroName="SHADER_DEFERRED_ENABLE" Value="1"/>
		</ConfigUnit>
	</ConfigUnits>
	

