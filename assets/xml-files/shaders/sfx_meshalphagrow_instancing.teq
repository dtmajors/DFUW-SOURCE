#include "stdstate.frag"
#include "stdio.frag"
#include "matrix.frag"
#include "windswing.frag"
#include "texture.frag"

#include "instancing.frag"
#include "ssao.frag"

#include "offscreenfx.frag"

bool InstancingShader : REInfoInstanceShader = true;
int InstanceVersion : REInfoInstanceType  = INSTANCE_WORLDMAT_DIFFUSE;



//float4 DiffMaterial : REPGlobalMaterialDiffuse = { 1.0f, 1.0f, 1.0f, 1.0f };


struct VS_OUTPUT
{
    float4 Pos  : POSITION;
    float4 Diff : COLOR0;
    float2 Tex  : TEXCOORD0;
	float ClipSpace : TEXCOORD2;
	float3 Growth : TEXCOORD3;
	float3 InputPos : TEXCOORD4;
    float Fog : FOG;
};


struct VS_INPUT
{
    float4 Pos	: POSITION;
    float3 Norm : Normal;
    float4 Diff : COLOR0;
    float2 Tex	: TEXCOORD0;
	//Instancing data	
	float4 DiffuseMaterialColor : COLOR1;
	float4 WMat1 : TEXCOORD5;
	float4 WMat2 : TEXCOORD6;
	float4 WMat3 : TEXCOORD7;
	float4 WMat4 : TEXCOORD8;
};

bool Transparent : REInfoTransparent = true;


VS_OUTPUT VS(VS_INPUT Input)
{
    VS_OUTPUT Out = (VS_OUTPUT)0;

	SFMatrix WMat;
	WMat[0] = Input.WMat1;
	WMat[1] = Input.WMat2;
	WMat[2] = Input.WMat3;
	WMat[3] = Input.WMat4;
	
	float4 DiffMaterial = Input.DiffuseMaterialColor;
	
	
	float4 Pos = Input.Pos;


	Pos.xyz += sin(TOTAL_TIME) * Input.Norm * 0.1f;
	
	
    SFMatrix WVP = mul(WMat,VIEW_PROJECTION_MATRIX);

   
    Out.Pos  = mul(Pos, WVP);             // position (projected)


#ifdef DEPTH_WRITE_ENABLE
	Out.ClipSpace = Out.Pos;
#endif
	

	float3 Growth;
	Growth.x = 1.0f - DiffMaterial.x;
	Growth.y = 1.0f - DiffMaterial.y;
	Growth.z = 1.0f - DiffMaterial.z;

	Out.Growth = Growth;
	Out.InputPos = Pos;
	
	float3 Scale = getAllMin(Pos);
	
	float DiffMultiplier = 1.0f;
	if (Scale.x > Growth.x)
		DiffMultiplier = 0.0f;
	if (Scale.y > Growth.y)
		DiffMultiplier = 0.0f;
	if (Scale.z > Growth.z)
		DiffMultiplier = 0.0f;
	
	float Transparancy = 1.0f - DiffMaterial.w;
	
	

    
    Out.Diff = 1.0f;
    Out.Diff.w = (Input.Diff.g) * Transparancy;
    
    
	Out.Tex = Input.Tex;
    Out.Tex.y  = Input.Tex.y + frac(TOTAL_TIME*0.35f);
    

    Out.Fog = CalculateFog_3_0(Out.Pos.z);

    return Out;
}


STD_PS_OUTPUT_3 PS(VS_OUTPUT Input)
{	
	STD_PS_OUTPUT_3 Out = (STD_PS_OUTPUT_3)0;
	float4 BaseTex = tex2D(DEFAULT_SAMPLER_2,Input.Tex);
	
	float4 Color = BaseTex * Input.Diff;

	float3 Scale = getAllMin(Input.InputPos);
	
	
	if (Scale.x > Input.Growth.x)
		Color.a = 0.0f;
	if (Scale.y > Input.Growth.y)
		Color.a = 0.0f;
	if (Scale.z > Input.Growth.z)
		Color.a = 0.0f;
	
	
	
	Color.xyz = lerp(Color.xyz,0,Input.Fog);

	Out.Color = Color;
	//Out.Effect = 0.0f;
	
#ifdef SSAO_ENABLE
	Out.Depth = SSAO_NO_EFFECT; //SSAO_getZVal(Input.ClipSpace.z / Input.ClipSpace.w);
#endif
	
	
	// OffscreenFX
	Out.Color = ProcessOffscreenFXColor(Out.Color, Input.ClipSpace);
	
	return Out;
}



//
//

technique T0
{
    pass P0
    {
		STD_STATE;
   
    
    
		ColorWriteEnable = RED|BLUE|GREEN;

        AlphaBlendEnable = true;
        AlphaTestEnable = false;
        SrcBlend = SrcAlpha;
        DestBlend = One;//InvSrcAlpha;
        
        ZEnable = true;
		ZWriteEnable = false;
	
		FogEnable = true;
        CullMode = NONE;
	
        VertexShader = compile vs_3_0 VS();
        PixelShader  = compile ps_3_0 PS();

    }
}
