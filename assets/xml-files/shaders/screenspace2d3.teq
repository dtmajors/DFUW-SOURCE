// Note: Check light model
#include "stdstate.frag"
#include "matrix.frag"
#include "time.frag"
#include "texture.frag"
#include "instancing.frag"
#include "ssao.frag"
#include "lighting.frag"
#include "std_vertex.frag"
#include "combine_illumination.frag"

//Tell that this one is an instancing shader
bool InstancingShader : REInfoInstanceShader = true;
int InstanceVersion : REInfoInstanceType  = INSTANCE_WORLDMAT_AMBIENT_DIFFUSE;

static const float UsefulWidth = 2048.0;
static const float UsefulHeight = 1024.0;

static const float TextureWidth = 2048.0;
static const float TextureHeight = 1024.0;

STD_VS_INSTANCE_OUTPUT VS(STD_VS_INSTANCE_INPUT Input)
{
	STD_VS_INSTANCE_OUTPUT Output = STD_VERTEX_SHADER_INSTANCE(Input);
	float Time = abs(sin((TOTAL_TIME + Input.Pos.y + Input.Pos.x + Input.Pos.z) * 1.31f));
	Time = lerp(0.6f,1.0f,Time);
    Output.Glow = Time; 
    return Output;
}

STD_PS_OUTPUT_3 PS(STD_VS_INSTANCE_OUTPUT Input, float2 ScreenPos : VPos)
{
	STD_PS_OUTPUT_3 Output = (STD_PS_OUTPUT_3)0;
	/*
	float UsefulAspect = UsefulWidth / UsefulHeight;
	float ScreenAspect = BackBufferParams.x / BackBufferParams.y;
	
	float2 OffsetPixels = 0;
	float PixelScaling = 1.0;
	
	if (ScreenAspect > UsefulAspect) {
		// width remains the same
		
		PixelScaling = UsefulWidth / BackBufferParams.x;
		float FinalHeight = BackBufferParams.y * PixelScaling;
		OffsetPixels.y = (BackBufferParams.y - FinalHeight) * 0.5;
	} else {
		// height remains the same
		PixelScaling = UsefulHeight / BackBufferParams.y;
		float FinalWidth = BackBufferParams.x * PixelScaling;
		OffsetPixels.x = (BackBufferParams.x - FinalWidth) * 0.5;
	}
	
	float2 PixelCoords = ScreenPos * PixelScaling + OffsetPixels;
	
	float2 tc = PixelCoords /  float2(TextureWidth, TextureHeight);
	float4 BaseTex = tex2D(DEFAULT_SAMPLER_2, tc);
	Output.Color = BaseTex;
	Output.Color.a = 0.0f;
	*/
	
	float2 tc = (ScreenPos / BackBufferParams) * float2(UsefulWidth, UsefulHeight) / float2(TextureWidth, TextureHeight);
	Output.Color = tex2D(DEFAULT_SAMPLER_2, tc);
	Output.Color.a = 0;

#ifdef DEPTH_WRITE_ENABLE
	Output.Depth.xyz = 0;
	Output.Depth.w = -1;
#endif

#ifdef MATERIAL_WRITE_ENABLE
	Output.Material = 0;
#endif
	
	return Output;

}

technique T0
{
    pass P0
    {
		STD_STATE;
    
		ColorWriteEnable = ALPHA|RED|BLUE|GREEN;

        AlphaTestEnable = false;

        AlphaBlendEnable = false;
        
        ZEnable = true;
		ZWriteEnable = true;
	
		FogEnable = true;
        CullMode = CCW;
		
        VertexShader = compile vs_3_0 VS();
        PixelShader  = compile ps_3_0 PS();
       

    }
}