#include "stdstate.frag"
#include "anim.frag"
#include "stdio.frag"
#include "matrix.frag"
#include "texture.frag"
#include "ssao.frag"
#include "lighting.frag"
#include "texturefunctions.frag"
#include "combine_illumination.frag"
#include "offscreenfx.frag"

#ifdef SHADER_DYNAMIC_LIGHTS_ENABLE
#include "dynamic_lights.frag"
#endif

static const float TIME_OF_ONE_FRAME = 1.0f/TEXANIM_NUM_FRAMES_PER_SECOND;
static const float NUM_FRAMES_SQRT = 4;
static const float ANIMATION_FREQUENCY = TIME_OF_ONE_FRAME * NUM_FRAMES_SQRT*NUM_FRAMES_SQRT;
 

// Matrix Pallette
float4x3    mWorldMatrixArray[ANIM_MAX_MATRICES] : REAnimWorldMatrixArray;

float4 DiffMaterial : REPGlobalMaterialDiffuse = { 1.0f, 1.0f, 1.0f, 1.0f };
float PowerMaterial : REPGlobalMaterialPower = 0.0f;

bool Transparent : REInfoTransparent = true; 
///////////////////////////////////////////////////////

struct VS_OUTPUT
{
    float4  Pos     		: POSITION;
    float2  Tex0    		: TEXCOORD0;
    float3 WorldNormal 		: TEXCOORD1;
    float3 WorldEyeVec 		: TEXCOORD2;
    float3 WorldPos 		: TEXCOORD3;
	float 	ZPos 			: TEXCOORD4;
	float4 ClipSpace		: TEXCOORD5;
    float   Fog	    		: FOG;
};



VS_OUTPUT VShade_2Weight(STD_VS_SKINNING_INPUT i)
{
    VS_OUTPUT   o = (VS_OUTPUT)0;
    float3      Pos = 0.0f;
    float3      Normal = 0.0f;    
    float       LastWeight = 0.0f;
    
    // Compensate for lack of UBYTE4 on Geforce3
    int4 IndexVector = D3DCOLORtoUBYTE4(i.BlendIndices);

    // cast the vectors to arrays for use in the for loop below
    float BlendWeightsArray[4] = (float[4])i.BlendWeights;
    int   IndexArray[4]        = (int[4])IndexVector;
    
    // calculate the pos/normal using the "normal" weights 
    //        and accumulate the weights to calculate the last weight

    LastWeight = BlendWeightsArray[0];
        
    Pos = mul(i.Pos, mWorldMatrixArray[IndexArray[0]]) * BlendWeightsArray[0];
    Normal = mul(i.Normal, mWorldMatrixArray[IndexArray[0]]) * BlendWeightsArray[0];

    LastWeight = 1.0f - LastWeight; 

    // Now that we have the calculated weight, add in the final influence
    Pos += (mul(i.Pos, mWorldMatrixArray[IndexArray[1]]) * LastWeight);
    Normal += (mul(i.Normal, mWorldMatrixArray[IndexArray[1]]) * LastWeight); 
    
    
    // transform position from world space into view and then projection space
    o.Pos = mul(float4(Pos.xyz, 1.0f), VIEW_PROJECTION_MATRIX);
	o.WorldPos = Pos;
	o.ZPos = o.Pos.z;
    // normalize normals
    Normal = normalize(Normal);

    // copy the input texture coordinate through
	o.Tex0 = SFGetTextureAnimation(i.Tex0.xy,ANIMATION_FREQUENCY,NUM_FRAMES_SQRT); 
	
	o.WorldNormal = Normal;
	
	o.WorldEyeVec  = normalize(EYE_POS - Pos);
    
    o.Fog = CalculateFog_3_0(o.Pos.z);

	o.ClipSpace = o.Pos;

    return o;
}



STD_PS_OUTPUT_3 PShade(VS_OUTPUT Input)
{
	STD_PS_OUTPUT_3 Out = (STD_PS_OUTPUT_3)0;
	float4 BaseTex = tex2D(DEFAULT_SAMPLER_2,Input.Tex0);

	float3 Nn = normalize(Input.WorldNormal);
	float3 Vn = normalize(Input.WorldEyeVec);
	
	float4 Sunlight = lightPixelSpecularDiffuseWrapRaw(Nn, Vn, TEXTUREANIM_SPECULAR_EXPONENT, TEXTUREANIM_DIFFUSE_WRAP, TEXTUREANIM_SPECULAR_CONTRIBUTION * BaseTex.y);
	
	float4 DynamicLight = float4(0, 0, 0, 0);
#ifdef SHADER_DYNAMIC_LIGHTS_ENABLE
	[loop] for (int i=0; i<ActiveLightCount; i++)
	{
		DynamicLight += pointLightPixelSpecularDiffuseWrapRaw(Input.WorldPos, Nn, TEXTUREANIM_SPECULAR_EXPONENT, 
			TEXTUREANIM_DIFFUSE_WRAP, TEXTUREANIM_SPECULAR_CONTRIBUTION * BaseTex.y, Vn, LightParams[i]);
	}
#endif
	
	Out.Color.xyz = combineIllumination3anim(float4(Input.WorldPos, 1), Input.ZPos, Input.Fog, BaseTex.xyz, Sunlight, DynamicLight);
	Out.Color.w = BaseTex.w * (1.0 - smoothstep(0,1,Input.Fog));	

	//Out.Effect = 0.0f;
#ifdef SSAO_ENABLE
	Out.Depth = SSAO_getZVal(Input.ZPos);
#endif


	// OffscreenFX
	Out.Color = ProcessOffscreenFXColor(Out.Color, Input.ClipSpace);

	return Out;
}



//////////////////////////////////////
// Techniques specs follow
//////////////////////////////////////
technique t0
{
    pass p0
    {
		STD_STATE;
		ColorWriteEnable = ALPHA|RED|BLUE|GREEN;
    	FogEnable = false;

        AlphaTestEnable = false;
        
        AlphaBlendEnable = true;
        SrcBlend = SrcAlpha;
        DestBlend = InvSrcAlpha; 
        ZEnable = true;
		ZWriteEnable = true;
       	CullMode = CCW;
        
    
    	VertexShader = compile vs_3_0 VShade_2Weight();
        PixelShader = compile ps_3_0 PShade();
    }
}

