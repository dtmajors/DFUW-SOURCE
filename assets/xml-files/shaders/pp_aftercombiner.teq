//After Combiner
#include "stdstate.frag"


texture PrevAfter : REPTexturePrevBlendTex;
texture ThisAfter : REPTextureSceneColor;
float FrameTime : REPFrameTime;


sampler2D PrevAfterSampler =
sampler_state
{
    Texture = <PrevAfter>;
    AddressU = Clamp;
    AddressV = Clamp;
//#ifdef SET_SAMPLERSTATE
    MinFilter = Point;
    MagFilter = Point;
//#endif	
};

sampler2D ThisAfterSampler =
sampler_state
{
    Texture = <ThisAfter>;
    AddressU = Clamp;
    AddressV = Clamp;
#ifdef SET_SAMPLERSTATE
    MinFilter = Point;
    MagFilter = Point;
#endif
};




float4 AfterCombiner( in float2 Tex : TEXCOORD0 ) : COLOR0
{
    //float4 PrevAfter = tex2D(PrevAfterSampler,Tex);
    float4 ThisAfter = tex2D(ThisAfterSampler,Tex);
	return ThisAfter;
