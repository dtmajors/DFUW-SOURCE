float4 AfterCombiner_1_1( in float2 Tex : TEXCOORD0 , in float2 Tex2 : TEXCOORD1) : COLOR0
{
    float4 PrevAfter = tex2D(PrevAfterSampler,Tex);
    float4 ThisAfter = tex2D(ThisAfterSampler,Tex2);

	  
    const float PixelDirt = (1.0f/255.0f);
    //float Mult = PrevAfter.a*0.95f + ThisAfter.a*0.05f;
    float Mult = PrevAfter.a*(1.0f - FrameTime) + ThisAfter.a*(FrameTime);
    Mult -= 0.01f;
	  
    float4 NewAfter = PrevAfter*Mult + ThisAfter*(1.0f-Mult) - PixelDirt;
    return NewAfter;
}



//
//

technique T0
{
    pass P0
    {
		STD_STATE;
        Lighting       = false;
        AlphaBlendEnable = FALSE;
        AlphaTestEnable = FALSE;
        ZEnable = FALSE;
	ZWriteEnable = FALSE;
	CullMode = CCW;
   
        VertexShader = null;
        PixelShader = compile ps_2_a AfterCombiner();
        ZEnable = false;
    
    }
}
