//Fish shader


#include "stdstate.frag"
#include "shaderconfig.frag"
#include "fog.frag"
#include "sampler.frag"
#include "matrix.frag"
#include "windswing.frag"
#include "atmosphere.frag"
#include "lighting.frag"
#include "texture.frag"

#include "alphaHDRL.frag"




struct VS_OUTPUT_TERR
{
    float4 Pos  : POSITION;
    float4 Diff : COLOR0;
    float2 Tex  : TEXCOORD0;
    float Fog : FOG;
};


struct VS_INPUT
{
    float3 Pos	: POSITION;
    float4 Diff : COLOR0;
    float3 Norm : Normal;
    float2 Tex	: TEXCOORD0;
};



VS_OUTPUT_TERR PropVS1_1(VS_INPUT Input)
{
    VS_OUTPUT_TERR Out = (VS_OUTPUT_TERR)0;


    SFMatrix WVP = mul(WORLD_MATRIX,VIEW_PROJECTION_MATRIX);

    float3 L = -PLANET_LIGHTDIR_COMMON;

	int4 IndexVector = D3DCOLORtoUBYTE4(Input.Diff);
	
	float Checker = (float)IndexVector[1]/255.0f;


	
	float Amplitude = (BBMax.z - BBMin.z)*0.2f;
	Amplitude *= (1.0f - Checker);
	float Frequency = 0.8f;
	float Rot = SFGetPeriodicSinTimeValue(0.0f,Amplitude, Frequency, 0.0f);

    
    float3 NewPos  = SFVectorRotateY(Input.Pos , Rot);
    float3 NewNorm = SFVectorRotateY(Input.Norm , Rot);
   
    Out.Pos  = mul(float4(NewPos,1.0f), WVP);             // position (projected)

    float3 WorldNorm = normalize(mul(NewNorm,(float3x3)WORLD_MATRIX));

	
    
    float Diff = max(0,dot(WorldNorm, L));
    
    Out.Diff = saturate((Diff * PLANET_LIGHTCOLOR_COMMON)  + ATMOSPHERE_AMBIENT + 0.4f);
    Out.Diff.w = saturate(0.01);
    
    Out.Tex  = Input.Tex;

    Out.Fog = CalculateFog_3_0(Out.Pos.z);

    return Out;
}



float4 AlphaTestPS(VS_OUTPUT_TERR Input) : COLOR
{
	
	float4 Out = (float4)0;
	float4 BaseTex = tex2D(DEFAULT_SAMPLER_2,Input.Tex);
	Out = BaseTex * Input.Diff;

	Out.a =getAlphaTestValHDR(BaseTex.a)*(Input.Diff.w);
	Out.xyz = lerp(Out.xyz,FOG_COLOR.xyz,Input.Fog);
	
	return Out;
}



//
//

technique T0
{
    pass P0
    {
		STD_STATE;

		ColorWriteEnable = ALPHA|RED|BLUE|GREEN;
        AlphaBlendEnable = FALSE;
        AlphaTestEnable = true;
        ALPHAREF = 0;
        ALPHAFUNC = NOTEQUAL;
        
        ZEnable = TRUE;
		ZWriteEnable = TRUE;
	
		FogEnable = FALSE;
        CullMode = CCW;
	
        VertexShader = compile vs_3_0 PropVS1_1();
        PixelShader  = compile ps_3_0 AlphaTestPS();

    }
}
