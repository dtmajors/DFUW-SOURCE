#include "stdstate.frag"
#include "stdio.frag"
#include "matrix.frag"
#include "windswing.frag"
#include "texture.frag"

#include "instancing.frag"
#include "ssao.frag"

#include "offscreenfx.frag"

bool InstancingShader : REInfoInstanceShader = true;
int InstanceVersion : REInfoInstanceType  = INSTANCE_WORLDMAT_AMBIENT_DIFFUSE;


struct VS_INPUT
{
    float4 Pos	: POSITION;
    float3 Norm : Normal;
    float4 Diff : COLOR0;
    float2 Tex	: TEXCOORD0;
	//Instancing data
	float4 WMat1 : TEXCOORD5;
	float4 WMat2 : TEXCOORD6;
	float4 WMat3 : TEXCOORD7;
	float4 WMat4 : TEXCOORD8;
};

struct VS_OUTPUT
{
    float4 Pos  : POSITION;
    float4 Diff : COLOR0;
    float2 Tex  : TEXCOORD0;
	float4 ClipSpace : TEXCOORD1;
    float Fog : FOG;
};


bool Transparent : REInfoTransparent = true;


VS_OUTPUT VS(VS_INPUT Input)
{
    VS_OUTPUT Out = (VS_OUTPUT)0;

	SFMatrix WMat;
	WMat[0] = Input.WMat1;
	WMat[1] = Input.WMat2;
	WMat[2] = Input.WMat3;
	WMat[3] = Input.WMat4;
	
	
	float4 Pos = Input.Pos;
	float3 AllMin = abs(Input.Pos - getBBCenter());
	
	float YVal = getYMin(Input.Pos.y);
	Pos.x += Input.Diff.b * Input.Norm.x * sin(TOTAL_TIME*1.1f) * AllMin.x * YVal;
	Pos.z += Input.Diff.b * Input.Norm.z * sin(TOTAL_TIME*1.24f) * AllMin.z * YVal;

	

    SFMatrix WVP = mul(WMat,VIEW_PROJECTION_MATRIX);

   
    Out.Pos  = mul(Pos, WVP);             // position (projected)

    
    Out.Diff = 1.0f;
    Out.Diff.w = (Input.Diff.g)*1.0f;
    
	Out.Tex = Input.Tex;
    Out.Tex.y  = Input.Tex.y + frac(TOTAL_TIME*0.1f);
    

    Out.Fog = CalculateFog_3_0(Out.Pos.z);
	Out.ClipSpace = Out.Pos;

    return Out;
}


STD_PS_OUTPUT_3 PS(VS_OUTPUT Input)
{	
	STD_PS_OUTPUT_3 Out = (STD_PS_OUTPUT_3)0;
	float4 Color;
	float4 BaseTex = tex2D(DEFAULT_SAMPLER_2,Input.Tex);
	Color = BaseTex * Input.Diff;
	Color.xyz = lerp(Color.xyz,0,Input.Fog);
	
	Out.Color = Color;
	//Out.Effect = 0.0f;
#ifdef SSAO_ENABLE
	Out.Depth = SSAO_NO_EFFECT;
#endif	
	
	
	// OffscreenFX
	Out.Color = ProcessOffscreenFXColor(Out.Color, Input.ClipSpace);
	
	return Out;
}



//
//

technique T0
{
    pass P0
    {
		STD_STATE;
		ColorWriteEnable = RED|BLUE|GREEN;

        AlphaBlendEnable = true;
        AlphaTestEnable = false;
        SrcBlend = SrcAlpha;
        DestBlend = One;//InvSrcAlpha;
        
        ZEnable = true;
		ZWriteEnable = false;
	
		FogEnable = true;
        CullMode = NONE;
	
        VertexShader = compile vs_3_0 VS();
        PixelShader  = compile ps_3_0 PS();
    }
}
