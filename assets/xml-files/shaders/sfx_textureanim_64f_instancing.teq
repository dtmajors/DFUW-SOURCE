#include "stdstate.frag"
#include "matrix.frag"
#include "texture.frag"
#include "instancing.frag"
#include "shadowmap.frag"
#include "ssao.frag"
#include "lighting.frag"
#include "texturefunctions.frag"
#include "std_vertex.frag"
#include "combine_illumination.frag"
#include "camera.frag"

#include "offscreenfx.frag"

static const float TIME_OF_ONE_FRAME = 1.0f/TEXANIM_NUM_FRAMES_PER_SECOND;
static const float NUM_FRAMES_SQRT = 8;
static const float ANIMATION_FREQUENCY = TIME_OF_ONE_FRAME * NUM_FRAMES_SQRT*NUM_FRAMES_SQRT;

#ifdef SHADER_DYNAMIC_LIGHTS_ENABLE
#include "dynamic_lights.frag"
#endif

//Tell that this one is an instancing shader
bool InstancingShader : REInfoInstanceShader = true;
int InstanceVersion : REInfoInstanceType  = INSTANCE_WORLDMAT_AMBIENT_DIFFUSE;

bool Transparent : REInfoTransparent = true;

STD_VS_INSTANCE_OUTPUT VS(STD_VS_INSTANCE_INPUT Input)
{
	STD_VS_INSTANCE_OUTPUT Out = STD_VERTEX_SHADER_INSTANCE(Input);
    Out.Tc = SFGetTextureAnimation(Input.Tex, ANIMATION_FREQUENCY, NUM_FRAMES_SQRT);

	return Out;
}

STD_PS_OUTPUT_3 PS(STD_VS_INSTANCE_OUTPUT Input, float2 ScreenPos : VPos)
{
	STD_PS_OUTPUT_3 ReturnVal = (STD_PS_OUTPUT_3)0;
	float4 SurfaceColor = tex2D(DEFAULT_SAMPLER_2, Input.Tc);
	
	float3 Nn = normalize(Input.WorldNormal);
	float3 Vn = normalize(Input.WorldEyeVec);
	
	
	float4 Sunlight = lightPixelSpecularDiffuseWrapRaw(Nn, Vn, TEXTUREANIM_SPECULAR_EXPONENT, TEXTUREANIM_DIFFUSE_WRAP, TEXTUREANIM_SPECULAR_CONTRIBUTION * SurfaceColor.y);

	float4 DynamicLight = float4(0, 0, 0, 0);
#ifdef SHADER_DYNAMIC_LIGHTS_ENABLE
	[loop] for (int i=0; i<ActiveLightCount; i++)
	{
		DynamicLight += pointLightPixelSpecularDiffuseWrapRaw(Input.WorldPos, Nn, TEXTUREANIM_SPECULAR_EXPONENT, 
			TEXTUREANIM_DIFFUSE_WRAP, TEXTUREANIM_SPECULAR_CONTRIBUTION * SurfaceColor.y, Vn, LightParams[i]);
	}
#endif


	ReturnVal.Color.xyz = combineIllumination3(float4(Input.WorldPos, 1), Input.ZPos, Input.Fog, SurfaceColor.xyz, Sunlight, DynamicLight);
	ReturnVal.Color.w = SurfaceColor.w;	
	//ReturnVal.Effect = 0.0f;
	
#ifdef SSAO_ENABLE
	if (ReturnVal.Color.w > SSAO_ALPHABLEND_MIN_ALPHA)
		ReturnVal.Depth = SSAO_getZVal(Input.ZPos);
	else
		ReturnVal.Depth = 0.0f;
#endif
	
	// OffscreenFX
	float2 ScreenTC = ScreenPos / BackBufferParams.xy;
	ReturnVal.Color = ProcessOffscreenFXColor(ReturnVal.Color, 
		Input.ZPos.x / Input.ZPos.y, ScreenTC);
	
	return ReturnVal;
}

technique T0
{
    pass P0
    {
		STD_STATE;
		ColorWriteEnable = RED|BLUE|GREEN;

        AlphaBlendEnable = true;
        AlphaTestEnable = false;
        SrcBlend = SrcAlpha;
        DestBlend = One;//InvSrcAlpha;
        
        ZEnable = true;
		ZWriteEnable = true;
	
		FogEnable = true;
        CullMode = CCW;
	
        VertexShader = compile vs_3_0 VS();
        PixelShader  = compile ps_3_0 PS();
    }
}
