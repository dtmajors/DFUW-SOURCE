// Note: Frequently used shader
//Default Shader instancing
#include "stdstate.frag"
#include "stdio.frag"
#include "matrix.frag"
#include "texture.frag"
#include "instancing.frag"
#include "ssao.frag"
#include "lighting.frag"
#include "std_vertex.frag"
#include "combine_illumination.frag"
#include "levitation.frag"
#include "objectbounding.frag"

#ifdef SHADER_DYNAMIC_OPAQUE_LIGHTS_ENABLE
#include "dynamic_lights.frag"
#endif

float WobbleDist = 0.004;
float WobbleSpeed = 20;

//Tell that this one is an instancing shader
bool InstancingShader : REInfoInstanceShader = true;
int InstanceVersion : REInfoInstanceType  = INSTANCE_WORLDMAT_AMBIENT_DIFFUSE;

float2 NormalToPhiTheta(float3 N) { return float2(acos(N.z), atan(N.y));}
float3 PhiThetaToNormal(float2 pt) { return float3(cos(pt.x) * sin(pt.y), sin(pt.x) * sin(pt.y), cos(pt.x));}

static const float PI = 3.14159265;

float3 Wobble(float3 Position, float3 Normal, float Scale, float Speed)
{
	float2 Spherical = NormalToPhiTheta(Normal);
	Position += Scale * Normal * WobbleDist * sin(6 * Spherical.x + TOTAL_TIME * Speed);
	Position += Scale * Normal * WobbleDist * sin(6 * Spherical.y + TOTAL_TIME * Speed);
	
	return Position;
}

float3 WobbleNormal(float3 Normal, float Speed)
{
	float2 pt = NormalToPhiTheta(Normal);
	pt += 0.01 * float2(sin(6 * pt.x + TOTAL_TIME * Speed), cos(6 * pt.y + TOTAL_TIME * Speed));
	return normalize(0.1 * Normal + PhiThetaToNormal(pt));
}

STD_VS_INSTANCE_OUTPUT WobbleVS(STD_VS_INSTANCE_INPUT Input)
{
	float WobbleScale = dot(getBBScale(), getBBScale()) * Input.Diff.b;
	float Speed = WobbleSpeed * Input.Diff.r;
	Input.Pos = float4(Wobble(Input.Pos.xyz, Input.Norm, WobbleScale, Speed), 1);
	Input.Norm = WobbleNormal(Input.Norm, Speed);
	STD_VS_INSTANCE_OUTPUT Output = STD_VERTEX_SHADER_INSTANCE(Input);
	
	
	return Output;
}

STD_PS_OUTPUT_3 PS(STD_VS_INSTANCE_OUTPUT Input)
{
	STD_PS_OUTPUT_3 Output = (STD_PS_OUTPUT_3)0;
	
	
	float4 SurfaceColor = tex2D(DEFAULT_SAMPLER_2, Input.Tc);
	
	float3 Nn = normalize(Input.WorldNormal);
	float3 Vn = normalize(Input.WorldEyeVec);
	
	float4 Sunlight = lightPixelSpecularDiffuseWrapRaw(Nn, Vn, STANDARD_PROP_SPECULAR_EXPONENT, STANDARD_PROP_DIFFUSE_WRAP, STANDARD_PROP_SPECULAR_CONTRIBUTION * SurfaceColor.y);
	
	float4 DynamicLight = float4(0, 0, 0, 0);
#ifdef SHADER_DYNAMIC_OPAQUE_LIGHTS_ENABLE
	[loop] for (int i=0; i<ActiveLightCount; i++)
	{
		DynamicLight += pointLightPixelSpecularDiffuseWrapRaw(Input.WorldPos, Nn, STANDARD_PROP_SPECULAR_EXPONENT, 
			STANDARD_PROP_DIFFUSE_WRAP, STANDARD_PROP_SPECULAR_CONTRIBUTION * SurfaceColor.y, Vn, LightParams[i]);
	}
#endif

	Output.Color.xyz = combineIllumination3(float4(Input.WorldPos, 1), Input.ZPos, Input.Fog, SurfaceColor.xyz, Sunlight, DynamicLight);
	Output.Color.w = SurfaceColor.w * (1.0 - smoothstep(0,1,Input.Fog));
	//Output.Effect = 0.0f;

#ifdef DEPTH_WRITE_ENABLE
	Output.Depth.xyz = Nn;
	Output.Depth.w = Input.ZPos.x / Input.ZPos.y;
#endif

#ifdef MATERIAL_WRITE_ENABLE
	Output.Material = float4(SurfaceColor.xyz, STANDARD_PROP_SPECULAR_CONTRIBUTION);
#endif
	
	return Output;
}

technique T0
{
    pass P0
    {
		STD_STATE;
   
    
		ColorWriteEnable = ALPHA|RED|BLUE|GREEN;

        AlphaBlendEnable = false;
        AlphaTestEnable = false;
        
        ZEnable = true;
		ZWriteEnable = true;
	
		FogEnable = false;
        CullMode = CCW;
	
        VertexShader = compile vs_3_0 WobbleVS();
        PixelShader  = compile ps_3_0 PS();

    }
}
