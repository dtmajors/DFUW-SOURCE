#include "stdstate.frag"
#include "stdio.frag"
#include "matrix.frag"
#include "windswing.frag"
#include "texture.frag"

#include "instancing.frag"
#include "ssao.frag"
#include "lighting.frag"
#include "combine_illumination.frag"

#include "offscreenfx.frag"

bool InstancingShader : REInfoInstanceShader = true;
int InstanceVersion : REInfoInstanceType  = INSTANCE_WORLDMAT_AMBIENT_DIFFUSE;


struct VS_INPUT
{
    float4 Pos	: POSITION;
    float3 Norm : Normal;
    float4 Diff : COLOR0;
    float2 Tex	: TEXCOORD0;
	//Instancing data
	float4 WMat1 : TEXCOORD5;
	float4 WMat2 : TEXCOORD6;
	float4 WMat3 : TEXCOORD7;
	float4 WMat4 : TEXCOORD8;
};

struct VS_OUTPUT
{
    float4 Pos  : POSITION;
    float4 Diff : COLOR0;
	float4 WorldPos : COLOR1;
    float2 Tex  : TEXCOORD0;
	float4 ClipSpace : TEXCOORD1;
    float Fog : FOG;
};


bool Transparent : REInfoTransparent = true;


VS_OUTPUT VS(VS_INPUT Input)
{
    VS_OUTPUT Out = (VS_OUTPUT)0;

	SFMatrix WMat;
	WMat[0] = Input.WMat1;
	WMat[1] = Input.WMat2;
	WMat[2] = Input.WMat3;
	WMat[3] = Input.WMat4;
	
	
	float4 Pos = Input.Pos;
	
	Pos.x += Input.Norm.x * sin(TOTAL_TIME*WATERWAVES_X_MOVEMENT_SPEED) * WATERWAVES_X_MOVEMENT_MULTIPLIER;
	Pos.z += Input.Norm.z * sin(TOTAL_TIME*WATERWAVES_Z_MOVEMENT_SPEED) * WATERWAVES_Z_MOVEMENT_MULTIPLIER;

    SFMatrix WVP = mul(WMat,VIEW_PROJECTION_MATRIX);

    Out.Pos  = mul(Pos, WVP);             // position (projected)
	Out.WorldPos = mul(float4(Pos.xyz, 1), WMat);
	
    Out.Diff = 1.0f;
    Out.Diff.w = (Input.Diff.g);
    
	Out.Tex = Input.Tex;
    Out.Tex.y  = Input.Tex.y + frac(TOTAL_TIME*WATERWAVES_Y_TEXTURE_SCROLL_SPEED);
    

    Out.Fog = CalculateFog_3_0(Out.Pos.z);
	Out.ClipSpace = Out.Pos;

    return Out;
}

STD_PS_OUTPUT_3 PS(VS_OUTPUT Input)
{	
	STD_PS_OUTPUT_3 Out = (STD_PS_OUTPUT_3)0;
	float4 BaseTex = tex2D(DEFAULT_SAMPLER_2,Input.Tex);
	BaseTex *= Input.Diff;
	
	Out.Color.xyz = combineIllumination3amb(Input.WorldPos.xyz,Input.Fog, BaseTex.xyz,WAVERWAVES_EXTRA_AMBIENT);
	Out.Color.w = BaseTex.w * (1.0 - Input.Fog);
	////Out.Effect = 0.0f;
	
#ifdef DEPTH_WRITE_ENABLE
	//Out.Depth.xyz = Nn;
	Out.Depth.w = Input.ClipSpace.z / Input.ClipSpace.w;
#endif


	// OffscreenFX
	Out.Color = ProcessOffscreenFXColor(Out.Color, Input.ClipSpace);


	return Out;
}



//
//

technique T0
{
    pass P0
    {
		STD_STATE;
		ColorWriteEnable = RED|BLUE|GREEN;

        AlphaBlendEnable = true;
        AlphaTestEnable = false;
        SrcBlend = SrcAlpha;
        DestBlend = InvSrcAlpha;
        
        ZEnable = true;
		ZWriteEnable = false;
	
		FogEnable = true;
        CullMode = NONE;
	
        VertexShader = compile vs_3_0 VS();
        PixelShader  = compile ps_3_0 PS();
    }
}
