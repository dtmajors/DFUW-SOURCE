// Note: CHECK LIGHTING MODEL
#include "stdstate.frag"
#include "stdio.frag"
#include "matrix.frag"
#include "windswing.frag"
#include "texture.frag"
#include "instancing.frag"
#include "ssao.frag"
#include "lighting.frag"
#include "std_vertex.frag"
#include "combine_illumination.frag"

#ifdef SHADER_DYNAMIC_OPAQUE_LIGHTS_ENABLE
#include "dynamic_lights.frag"
#endif

//Tell that this one is an instancing shader
bool InstancingShader : REInfoInstanceShader = true;
int InstanceVersion : REInfoInstanceType  = INSTANCE_WORLDMAT_AMBIENT_DIFFUSE;

float minAlpha = 0.01;

STD_VS_INSTANCE_OUTPUT VS(STD_VS_INSTANCE_INPUT Input)
{
	STD_VS_INSTANCE_OUTPUT Out = STD_VERTEX_SHADER_INSTANCE(Input);
	Out.Tc.y += frac(TOTAL_TIME * PROP_CKEY_TEXTURE_CYCLE_SPEED);
	return Out;
}

STD_PS_OUTPUT_3 PS(STD_VS_INSTANCE_OUTPUT Input)
{
	STD_PS_OUTPUT_3 Output = (STD_PS_OUTPUT_3)0;
	
	float4 Color = (float4)0;
	float4 SurfaceColor = tex2D(DEFAULT_SAMPLER_2, Input.Tc);
	
	if (SurfaceColor.a < minAlpha)
	{
		clip(-0.5f);
	}
	
	float3 Nn = normalize(Input.WorldNormal);
	float3 Vn = normalize(Input.WorldEyeVec);
	
	float4 Sunlight = lightPixelSpecularDiffuseWrapRaw(Nn, Vn, STANDARD_PROP_SPECULAR_EXPONENT, STANDARD_PROP_DIFFUSE_WRAP, STANDARD_PROP_SPECULAR_CONTRIBUTION * SurfaceColor.y);

	float4 DynamicLight = float4(0, 0, 0, 0);
	
	//Output.Color = ATMOSPHERE_AMBIENT * SurfaceColor;
	//Output.Color = SurfaceColor ;
	//Output.Color.xyz = lerp(Output.Color.xyz, FOG_COLOR.xyz, Input.Fog);
	//SurfaceColor = lerp(SurfaceColor.xyz, FOG_COLOR.xyz, Input.Fog);
	Output.Color.xyz = combineIllumination3(float4(Input.WorldPos, 1), Input.ZPos, Input.Fog, SurfaceColor.xyz, Sunlight, DynamicLight);
	//Output.Color.a = 0.5 * smoothstep(minAlpha, 1, SurfaceColor.a);
	Output.Color.a = 0.2;
	
#ifdef DEPTH_WRITE_ENABLE
	Output.Depth.xyz = Nn;
	Output.Depth.w = Input.ZPos.x / Input.ZPos.y;
#endif

#ifdef MATERIAL_WRITE_ENABLE
	Output.Material = float4(SurfaceColor.xyz, 0.2);
#endif
	
	return Output;
}

technique T0
{
    pass P0
    {
		STD_STATE;
   
    
		ColorWriteEnable = ALPHA|RED|BLUE|GREEN;

        AlphaBlendEnable = false;
        AlphaTestEnable = false;
        
        ZEnable = true;
		ZWriteEnable = true;
	
		FogEnable = false;
        CullMode = CCW;
	
        VertexShader = compile vs_3_0 VS();
        PixelShader  = compile ps_3_0 PS();

    }
}
