//Bloom 4 sample


#include "stdstate.frag"
#include "camera.frag"

texture SourceColor : REPTextureSourceColor;


sampler2D SrcColorSampler =
sampler_state
{
    Texture = <SourceColor>;
    AddressU = Clamp;
    AddressV = Clamp;
/*#ifdef SET_SAMPLERSTATE
    MinFilter = Point;
    MagFilter = Linear;
    MipFilter = Linear;
#endif	*/
};




