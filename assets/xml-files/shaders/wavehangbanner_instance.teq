// Note: MOVE LIGHTS TO PS
#include "stdstate.frag"
#include "stdio.frag"
#include "matrix.frag"
#include "spenebump.frag"
#include "windswing.frag"
#include "texture.frag"
#include "instancing.frag"
#include "ssao.frag"
#include "lighting.frag"
#include "combine_illumination.frag"

#ifdef SHADER_DYNAMIC_OPAQUE_LIGHTS_ENABLE
#include "dynamic_lights.frag"
#endif

bool InstancingShader : REInfoInstanceShader = true;
int InstanceVersion : REInfoInstanceType  = INSTANCE_WORLDMAT_AMBIENT_DIFFUSE;

struct VS_OUTPUT
{
    float4 Pos          : POSITION;
    float4 SunLight     : COLOR0;
#ifdef SHADER_DYNAMIC_OPAQUE_LIGHTS_ENABLE
	float4 DynamicLight : COLOR1;
#endif
    float2 Tex          : TEXCOORD0;
    float4 WorldPos     : TEXCOORD1;
	float2 ZPos 	    : TEXCOORD2;
	float3 WorldNormal  : TEXCOORD3;
	float3 WorldEyeVec  : TEXCOORD4;
    float Fog           : FOG;
};

static const float RetractStart = 0.7f;


VS_OUTPUT VS(STD_VS_INSTANCE_INPUT Input)
{
    VS_OUTPUT Out = (VS_OUTPUT)0;

	SFMatrix WMat;
	WMat[0] = Input.WMat1;
	WMat[1] = Input.WMat2;
	WMat[2] = Input.WMat3;
	WMat[3] = Input.WMat4;
	
    float3 ObjectSize = getBBScale();
    float3 MinValues;
    float3 NewPos = Input.Pos;
    MinValues.x = getXMin(NewPos.x);
    MinValues.y = getYMin(NewPos.y);

	float3 RandSeed = SFMatrixNonTranslationSummary(WMat);
	float RandVal = frac(RandSeed.x + RandSeed.y + RandSeed.z);
	
	float OSizeSq = getYMax(NewPos.y);
	OSizeSq *= OSizeSq;
	OSizeSq *= 0.5f;
	
    float WaveVal1 = SFGetPeriodicSinTimeValue( 0.0f , OSizeSq,   WIND_SPEED * 1.0f , RandVal + (MinValues.y*0.25f));

	WaveVal1 = abs(WaveVal1);
	float ScaledWav = WaveVal1/OSizeSq;
	ScaledWav *= 0.25f;
    
    NewPos.z += WaveVal1;
    
	float4 WorldPos = mul(float4(NewPos,1.0f),WMat);
	Out.WorldPos = WorldPos;
    Out.Pos  = mul(WorldPos, VIEW_PROJECTION_MATRIX);             // position (projected)
	Out.ZPos = Out.Pos.zw;
	
    float3 WorldNorm = normalize(mul(Input.Norm,(float3x3)WMat));
    
    float Diff = abs(dot(WorldNorm, -PLANET_LIGHTDIR_COMMON));
    Diff = saturate(Diff + ScaledWav);
    
	Out.SunLight.xyz = Diff * PLANET_LIGHTCOLOR_COMMON;
	Out.SunLight.w = 0.0f;
	
#ifdef SHADER_DYNAMIC_OPAQUE_LIGHTS_ENABLE
	Out.DynamicLight = float4(0,0,0,0);
	[loop] for (int i=0; i<ActiveLightCount; i++)
		Out.DynamicLight += pointLightPixelDiffuseRaw(WorldPos, WorldNorm, LightParams[i]);
#endif
    
	Out.WorldNormal = WorldNorm;
	Out.WorldEyeVec = normalize(WorldPos.xyz - EyePos);
    Out.Tex  = Input.Tex;
    Out.Fog = CalculateFog_3_0(Out.Pos.z);

    return Out;
}

STD_PS_OUTPUT_3 PS(VS_OUTPUT Input)
{
	STD_PS_OUTPUT_3 Output = (STD_PS_OUTPUT_3)0;
	
	float4 SurfaceColor = tex2D(DEFAULT_SAMPLER_2,Input.Tex);
	if (SurfaceColor.a < ALPHA_TEST_VALUE) clip(-1);
	float Specular = SurfaceColor.y;
	
	float3 Vn = normalize(Input.WorldEyeVec);
	float3 Nn = normalize(Input.WorldNormal);
	
	float4 Weather = applyAtmosphere(SurfaceColor.xyz,Input.WorldPos,Vn,Nn,Nn,Input.Tex*0.5,Specular,0.3);
	
	float4 DynamicLight = float4(0,0,0,0);
#ifdef SHADER_DYNAMIC_OPAQUE_LIGHTS_ENABLE
	DynamicLight = Input.DynamicLight;
#endif

	Output.Color.xyz = combineWeatherIllumination3(Input.WorldPos, Input.ZPos, Input.Fog, SurfaceColor.xyz, Input.SunLight, DynamicLight, 0, Weather.xyz, 0);
	Output.Color.w = 0.0f;

#ifdef DEPTH_WRITE_ENABLE
	Output.Depth.xyz = normalize(Input.WorldNormal);
	Output.Depth.w = Input.ZPos.x / Input.ZPos.y;
#endif

#ifdef MATERIAL_WRITE_ENABLE
	Output.Material = float4(SurfaceColor.xyz, 0);
#endif

	return Output;
}

technique T0
{
    pass P0
    {
		STD_STATE;
		ColorWriteEnable = ALPHA|RED|BLUE|GREEN;

        AlphaBlendEnable = false;
        AlphaTestEnable = false;
        
        ZEnable = true;
		ZWriteEnable = true;
	
		FogEnable = false;
        CullMode = CCW;
	
        VertexShader = compile vs_3_0 VS();
        PixelShader  = compile ps_3_0 PS();
    }
}
